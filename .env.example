# Planning example only. Never put real values in version control.

# Buzz relay identity/access
BUZZ_RELAY_URL=https://replace-with-buzz-relay
BUZZ_PRIVATE_KEY=replace-from-secret-store
BUZZ_CHANNELS=replace-with-comma-separated-channel-ids
BUZZ_ALLOWED_USERS=replace-with-comma-separated-npubs-or-hex-keys
BUZZ_ALLOW_ALL_USERS=false

# buzz-acp → Hermes native ACP
BUZZ_ACP_AGENT_COMMAND=hermes-acp
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MCP_COMMAND=
BUZZ_ACP_IDLE_TIMEOUT=900
BUZZ_ACP_MAX_TURN_DURATION=3600
BUZZ_ACP_SYSTEM_PROMPT_FILE=/etc/agent-factory/bootstrap.md
BUZZ_ACP_AGENTS=1
BUZZ_ACP_AGENT_OWNER=replace-with-owner-public-key

# Hermes
HERMES_HOME=/var/lib/hermes
HERMES_ACCEPT_HOOKS=1
HERMES_MODEL=replace-with-tested-omniroute-model
OMNIROUTE_INTERNAL_API_KEY=replace-from-omniroute-key-creation

# First-party composite Hermes memory provider (FACTORY_* are project-defined)
FACTORY_MEMORY_BASE_URL=http://ai-memory:49374
FACTORY_MEMORY_CLIENT_TOKEN=replace-with-least-privilege-token
FACTORY_MEMORY_WORKSPACE=factory
FACTORY_COMPANY_PROJECT=_global
FACTORY_TEAM_ID=replace-with-team-id
FACTORY_PROJECT_ID=replace-with-project-id
FACTORY_AGENT_ID=replace-with-agent-id
FACTORY_MEMORY_REQUIRED_DEFAULT=false

# ai-memory server
AI_MEMORY_DATA_DIR=/var/lib/ai-memory
AI_MEMORY_AUTH_TOKEN=replace-with-operator-root-token
AI_MEMORY_AUTH__TOKEN_PEPPER=replace-with-ai-memory-init-generated-pepper
AI_MEMORY_AUTO_IMPROVE__REQUIRE_APPROVAL=true
AI_MEMORY_AUTO_IMPROVE__SCHEDULER__ENABLED=false
AI_MEMORY_MAINTENANCE__ENABLED=false
AI_MEMORY_SLOTS__PER_USER=false

# Leave ai-memory LLM/embeddings unset initially. If enabled, use scoped
# OmniRoute credentials and the exact names supported by the pinned version.

# OmniRoute bootstrap/persistence
JWT_SECRET=replace-with-long-random-secret
API_KEY_SECRET=replace-with-long-random-secret
STORAGE_ENCRYPTION_KEY=replace-with-supported-random-key
INITIAL_PASSWORD=replace-do-not-use-CHANGEME
DATA_DIR=/data

# Upstream provider credentials belong to OmniRoute only and are configured
# through its reviewed stateful setup flow.

# First-party policy hook/service
POLICY_URL=http://policy:8080/v1/decide
POLICY_CLIENT_TOKEN=replace-with-scoped-client-token
POLICY_BUNDLE=/etc/agent-factory/policy/policy.bundle.json

# Project-defined research-plane controls. These are contracts to implement,
# not claims about upstream JIT/GBrain/PandaProbe/HarnessRouter env variables.
FACTORY_DREAM_ENABLED=false
FACTORY_DREAM_INPUT=/artifacts/exports
FACTORY_DREAM_OUTPUT=/artifacts/proposals
FACTORY_FOUNDRY_ENABLED=false
FACTORY_FOUNDRY_OUTPUT=/artifacts/candidates
FACTORY_EVALUATION_ENABLED=false
FACTORY_PANDAPROBE_ENABLED=false
FACTORY_HARNESSROUTER_ENABLED=false
