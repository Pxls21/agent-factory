class UsageParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.exit(64, f"decide-harvest: {message}\n")


@dataclass(frozen=True)
class Source:
    path: str
    kind: str
    data: bytes
    text: str
    digest: str


@dataclass(frozen=True)
class Candidate:
    line: int
    question_id: str
    producer: str
    answer: str
    state: dict
    locator: str
    reason: str | None = None


@dataclass(frozen=True)
class Refusal:
    path: str
    line: int
    reason: str


def _git(root: Path, *args: str, input_data: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        input=input_data,
        capture_output=True,
        check=False,
    )


def _repo_root(raw_root: str) -> Path | None:
    root = Path(raw_root).resolve()
    probe = _git(root, "rev-parse", "--show-toplevel")
    if probe.returncode != 0:
        return None
    try:
        top = Path(probe.stdout.decode("utf-8", "strict").strip()).resolve()
    except UnicodeDecodeError:
        return None
    return root if top == root else None


def _kind(path: str) -> str | None:
    if path == "docs/INCIDENT-LOG.md":
        return "incident_log"
    parts = PurePosixPath(path).parts
    if len(parts) == 3 and parts[0] == "transcripts" and path.endswith(".jsonl"):
        return "transcript_jsonl"
    if len(parts) != 4 or parts[:2] != ("tasks", "briefs"):
        return None
    name = parts[-1]
    if name.startswith("VERIFY-") and name.endswith("-report.md"):
        return "verify_report"
    if name.startswith("report-pc-verify-") and PC_VERIFY_REPORT_RE.fullmatch(name):
        return "verify_report"
    if not name.startswith("VERIFY-") and name.endswith("-report.md"):
        return "lane_report"
    if name.startswith("report-pc-") and not name.startswith("report-pc-verify-") and name.endswith(".md"):
        return "lane_report"
    return None


def _resolve_commit(root: Path) -> str | None:
    # The ONE read of the symbolic ref: every later git argument names this commit id (R3).
    result = _git(root, "rev-parse", "--verify", "HEAD^{commit}")
    commit = result.stdout.decode("ascii", "replace").strip()
    if result.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", commit):
        return None
    return commit


def _tree_paths(root: Path, commit: str) -> list[str] | None:
    result = _git(root, "ls-tree", "-r", "--name-only", "-z", commit)
    if result.returncode != 0:
        return None
    try:
        paths = [p.decode("utf-8", "strict") for p in result.stdout.split(b"\0") if p]
    except UnicodeDecodeError:
        return None
    return sorted(paths, key=lambda p: p.encode("utf-8"))


def _head_blob(root: Path, commit: str, path: str) -> bytes | None:
    result = _git(root, "cat-file", "blob", f"{commit}:{path}")
    return result.stdout if result.returncode == 0 else None


def _regular_worktree_bytes(root: Path, path: str) -> bytes | None:
    # One open, then the type check on THAT fd: a FIFO or a symlink swapped in is refused, never read
    # (a path check followed by a second open could block on a FIFO; S1, the ledger's own pattern).
    try:
        fd = os.open(root / path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    except OSError:
        return None
    finally:
        os.close(fd)


def _admit(root: Path, commit: str, requested: list[str]) -> tuple[list[Source] | None, tuple[int, str] | None]:
    tree_paths = _tree_paths(root, commit)
    if tree_paths is None:
        return None, (64, "decide-harvest: --root is not a git work tree")
    if requested:
        unknown = sorted((p for p in requested if _kind(p) is None), key=lambda p: p.encode("utf-8"))
        if unknown:
            return None, (5, f"harvest-source-unknown: {unknown[0]}")
        paths = sorted(set(requested), key=lambda p: p.encode("utf-8"))
    else:
        paths = [p for p in tree_paths if _kind(p) is not None]

    admitted: list[Source] = []
    for path in paths:
        data = _head_blob(root, commit, path)
        if data is None or _regular_worktree_bytes(root, path) != data:
            return None, (4, f"harvest-source-uncommitted: {path}")
        try:
            text = data.decode("utf-8", "strict")
        except UnicodeDecodeError:
            return None, (3, f"harvest-source-unparseable: {path}:1 (bad-utf8)")
        admitted.append(
            Source(
                path=path,
                kind=_kind(path) or "",
                data=data,
                text=text,
                digest=hashlib.sha256(data).hexdigest(),
            )
        )
    return admitted, None


def _split_table_row(line: str) -> list[str] | None:
    stripped = line.strip()
    if not stripped.startswith("|") or not stripped.endswith("|"):
        return None
    cells: list[str] = []
    current: list[str] = []
    escaped = False
    for char in stripped[1:-1]:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            current.append(char)
            escaped = True
        elif char == "|":
            cells.append("".join(current).strip())
            current = []
        else:
            current.append(char)
    cells.append("".join(current).strip())
    return cells


def _is_separator(cells: list[str] | None) -> bool:
    return bool(cells) and all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells)


def _collapse(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def _lines(text: str) -> list[str]:
    # Git's and the contract's lines: split on "\n" only (U+2028, U+0085, \x0b, \x0c and \x1c-\x1e are
    # text, AF-AP-132); the final empty piece is dropped and one trailing "\r" per line removed (R4).
    pieces = text.split("\n")
    if pieces[-1] == "":
        pieces.pop()
    return [piece[:-1] if piece.endswith("\r") else piece for piece in pieces]


def _heading_text(lines: list[str], start: int) -> tuple[str | None, str | None]:
    first = lines[start]
    opening = first.find("**")
    if opening < 0:
        return None, "unterminated-heading"
    pieces: list[str] = []
    for offset in range(10):
        index = start + offset
        if index >= len(lines):
            break
        piece = first[opening + 2 :] if offset == 0 else lines[index]
        close = piece.find("**")
        if close >= 0:
            return _collapse(" ".join(pieces + [piece[:close]])), None
        pieces.append(piece)
    return None, "unterminated-heading"


def _nearest_heading(lines: list[str], before: int) -> str:
    for index in range(before - 1, -1, -1):
        match = MARKDOWN_HEADING_RE.match(lines[index])
        if match:
            return _collapse(match.group("text"))
    return "document"


def _registry(text: str) -> dict[str, str]:
    lines = _lines(text)
    heading = next((i for i, line in enumerate(lines) if line.startswith("## ANTI-PATTERN REGISTRY")), -1)
    if heading < 0:
        return {}
    header_cells = _split_table_row("| id | mechanism | greppable signature | proven instance | status |")
    for index in range(heading + 1, len(lines) - 1):
        if _split_table_row(lines[index]) != header_cells or not _is_separator(_split_table_row(lines[index + 1])):
            continue
        rows: dict[str, str] = {}
        for line in lines[index + 2 :]:
            cells = _split_table_row(line)
            if cells is None:
                break
            if len(cells) >= 2 and AP_RE.fullmatch(cells[0]):
                rows[cells[0]] = cells[1]
        return rows
    return {}


def _unique_ap_ids(text: str) -> list[str]:
    return list(dict.fromkeys(AP_RE.findall(text)))


def _ap_candidate(
    *, line: int, path: str, title: str, row_id: str, row_title: str, producer: str
) -> Candidate:
    return Candidate(
        line=line,
        question_id="ap.violates_row",
        producer=producer,
        answer="yes",
        state={
            "action_kind": "report",
            "action_target": path,
            "action_excerpt": title,
            "row_id": row_id,
            "row_title": row_title,
        },
        locator=title[:200],
    )


def _parse_incident(source: Source, registry: dict[str, str]) -> list[Candidate]:
    lines = _lines(source.text)
    candidates: list[Candidate] = []
    for index, line in enumerate(lines):
        if not INCIDENT_ANCHOR_RE.match(line):
            continue
        heading, reason = _heading_text(lines, index)
        if reason:
            candidates.append(Candidate(index + 1, "", "", "", {}, "", reason))
            continue
        assert heading is not None
        for row_id in _unique_ap_ids(heading):
            title = registry.get(row_id)
            if title is None:
                candidates.append(Candidate(index + 1, "", "", "", {}, "", "no-registry-row"))
                continue
            candidates.append(
                _ap_candidate(
                    line=index + 1,
                    path=source.path,
                    title=heading,
                    row_id=row_id,
                    row_title=title,
                    producer="coordinator",
                )
            )
    return candidates


def _report_lane(path: str) -> str:
    name = PurePosixPath(path).name
    if name.startswith("VERIFY-") and name.endswith("-report.md"):
        return name[: -len("-report.md")]
    if name.startswith("report-"):
        lane = name[len("report-") :]
        if lane.endswith(".md"):
            lane = lane[:-3]
        return lane
    raise ValueError(path)


def _title_column(headers: list[str]) -> int | None:
    for index, header in enumerate(headers):
        lowered = header.strip().lower()
        if lowered.startswith("finding") or lowered == "what":
            return index
    return None


def _parse_class(cell: str) -> str | None:
    raw = cell.replace("*", "").strip()
    match = re.fullmatch(
        r"(BLOCKER|FOLLOW-UP|INFO|UNVERIFIED|CONTRACT-DEFECT|KNOWN)"
        r"(?:, (?:SOLID|UNSURE)| \([^\r\n()]+\))?",
        raw,
    )
    return match.group(1) if match else None


def _report_paths(text: str, tree: set[str]) -> list[str]:
    found: set[str] = set()
    for token in BACKTICK_RE.findall(text):
        candidate = re.sub(r":\d+(?:(?:-|–)\d+)?(?:[,:].*)?$", "", token)
        if candidate in tree:
            found.add(candidate)
    return sorted(found)


# DSV2 (task #251; D-083, D-085): finding anchors in formats the grammar does not admit, DATA-INT's families
# (docs/research/findings/laya-ft-data/INTERNAL-LABELS-2026-09-25.md section 3.2; the brief's AMENDMENT 1). They sit
# BESIDE the grammar's helpers: j2c.py and the Laya dataset's version 1 call those helpers, so none of them changes.
FAMILY_CLASS = r"(?P<cls>BLOCKER|FOLLOW-UP|INFO|UNVERIFIED|CONTRACT-DEFECT|KNOWN)"
FAMILY_ID = r"(?P<id>[A-Za-z][A-Za-z0-9._-]*\d[A-Za-z0-9._-]*|\d+[A-Za-z]?)"
FAMILY_SEP = r"\s*(?:—|–|-|·|:)\s*"
FAMILY_ANCHORS = (  # first match wins, on a line the grammar does not admit
    ("F1", re.compile(r"^- \*\*" + FAMILY_ID + r" " + FAMILY_CLASS + r"\b")),
    ("F2", re.compile(r"^\*\*" + FAMILY_ID + r"\s+" + FAMILY_CLASS + r"\b")),
    ("F3", re.compile(r"^(?:[-*] )?\*\*" + FAMILY_ID + FAMILY_SEP + r"\*{0,2}" + FAMILY_CLASS + r"\b")),
    ("F4", re.compile(r"^(?:[-*] )?\*\*" + FAMILY_ID + r"\s*\(\s*" + FAMILY_CLASS + r"\b")),
    ("F6", re.compile(r"^#{2,6}\s+(?:\*\*)?" + FAMILY_ID + r"(?:" + FAMILY_SEP + r"|\s+|\s*\()\*{0,2}\(?"
                      + FAMILY_CLASS + r"\b")),
    ("F7", re.compile(r"^\d+\.\s+(?:\*\*)?" + FAMILY_ID + r"(?:" + FAMILY_SEP + r"|\s+|\s*\()\*{0,2}\(?"
                      + FAMILY_CLASS + r"\b")),
    ("F8", re.compile(r"^(?P<num>\d+)\.\s+(?:\*\*)?" + FAMILY_CLASS
                      + r"\b(?:\*{0,2}\s+(?P<id2>[A-Za-z][A-Za-z0-9._-]*\d[A-Za-z0-9._-]*)\b)?")),
    ("F11", re.compile(r"^- \*\*(?P<id>" + FAMILY_CLASS + r"-\d+)\b")),
    ("F12", re.compile(r"^- " + FAMILY_ID + r"(?:" + FAMILY_SEP + r"|\s+|\s*\()\*{0,2}\(?" + FAMILY_CLASS + r"\b")),
)
FAMILY_ID_RE = re.compile(r"[A-Za-z][A-Za-z0-9._-]*\d[A-Za-z0-9._-]*|\d+[A-Za-z]?")
CLASS_START_RE = re.compile(r"(BLOCKER|FOLLOW-UP|INFO|UNVERIFIED|CONTRACT-DEFECT|KNOWN)\b")
# Two class words in the class slot: a second one joined to the first by `/`, `,`, `&` or `or` (`FOLLOW-UP / INFO`,
# `(UNVERIFIED, FOLLOW-UP)`). A qualifier after the class, or a class word later in the prose, is not in the slot.
SLOT_JOINER_RE = re.compile(r"\s*\**\s*(?:/|,|&|\bor\b)\s*\**\s*\(?\s*"
                            r"(?:BLOCKER|FOLLOW-UP|INFO|UNVERIFIED|CONTRACT-DEFECT|KNOWN)\b")
HRULE_RE = re.compile(r"^ {0,3}(?:-{3,}|\*{3,}|_{3,})\s*$")
LIST_MARKER_RE = re.compile(r"^(?:(?P<num>\d+[.)])|[-*+])\s")
# After a blank line, an unindented line that ends a list item: a report's verdict (a gate word, a gate
# recommendation, a "No <CLASS>" summary) rather than the item's own text.
VERDICT_LINE_RE = re.compile(
    r"\b(?:MERGE-READY|NOT-READY|CONTRACT-INVALID)\b|^(?:\*\*)?(?i:gate recommendation)\b"
    r"|^No (?:BLOCKER|FOLLOW-UP|INFO|UNVERIFIED|CONTRACT-DEFECT|KNOWN)\b"
)
BLOCK_CAP = 60  # lines; a longer block is cut and says so ("cap")
F13_TITLE_HEADERS = ("what", "one line")  # and every header that starts with "finding" (the grammar's `_title_column`)
F13_CLASS_HEADERS = ("class", "severity")
PREDICATE_HEADER_RE = re.compile(r"^\d+\s+(?:contract|canonical|material|discriminator|in boundary)\b")


@dataclass(frozen=True)
class FamilyFinding:
    line: int  # the anchor's line index (a table row's, for F13)
    family: str
    finding_id: str
    finding_class: str
    title: str
    text: str  # the finding block (F13: the title cell, as the grammar's table rows keep)
    block_end: str  # what ended the block: anchor, heading, rule, list, eof, cap; F13: cell
    reason: str | None = None  # None: admitted; "ambiguous-class": refused; "restated": an id already admitted


def _is_grammar_table(headers: list[str]) -> bool:
    return len(headers) >= 2 and headers[0].strip().lower() in {"#", "id"} and headers[1].strip().lower() == "class"


def _f13_columns(headers: list[str]) -> tuple[int, int, int] | None:
    """(id, class, title) column indexes of a table F13 admits rows from, or None: a table with a title column, a class
    column of its own, and no numbered blocking-predicate column (those cells are the label's own evidence)."""
    lowered = [header.strip().lower() for header in headers]
    if _is_grammar_table(headers) or any(PREDICATE_HEADER_RE.match(header) for header in lowered):
        return None
    title = next((k for k, h in enumerate(lowered) if h.startswith("finding") or h in F13_TITLE_HEADERS), None)
    klass = next((k for k, h in enumerate(lowered) if h in F13_CLASS_HEADERS), None)
    ident = next((k for k, h in enumerate(lowered) if h in ("id", "#")), None)
    return None if title is None or klass is None or ident is None else (ident, klass, title)


def _family_title(lines: list[str], index: int, start: int, end: int) -> str:
    """The anchor's text after its class slot, through the line that closes a wrapped bold span; bold markers dropped,
    leading separators cut. An anchor that carries nothing more takes the next non-blank line of its block."""
    first = lines[index]
    parts = [first[start:]]
    if first.count("**") % 2 == 1:  # an unclosed bold span wraps onto the next lines
        for later in range(index + 1, min(index + 10, len(lines))):
            parts.append(lines[later])
            if "**" in lines[later]:
                break
    title = _collapse(" ".join(parts).replace("**", "")).lstrip(" —–-·:.),/")
    if not title:
        title = next((_collapse(line.replace("**", "")) for line in lines[index + 1 : end] if line.strip()), "")
    return title


def _section_title(line: str) -> bool:
    """A short unpunctuated line that names a report section ("Reproduced controls"), not a list item's text."""
    text = line.strip()
    return (
        len(text) <= 60
        and not LIST_MARKER_RE.match(text)
        and not text.startswith(("|", "`", "**", ">", "#"))
        and not re.search(r"[.:;,?!)\]`*]$", text)
    )


def _family_block_end(lines: list[str], index: int, family: str, stops: set[int]) -> tuple[int, str]:
    """(end, what ended it): the block runs from the anchor to the next anchor line of any family or of the grammar, a
    markdown heading (F6: one of the same or a higher level) or a horizontal rule. A list-item anchor also ends, after a
    blank line, at an unindented sibling item, section title or verdict line. Trailing blank lines are dropped; a block
    longer than BLOCK_CAP lines is cut there ("cap")."""
    anchor = lines[index]
    level = len(anchor) - len(anchor.lstrip("#")) if family == "F6" else 0
    marker = LIST_MARKER_RE.match(anchor)
    end, why = len(lines), "eof"
    for later in range(index + 1, len(lines)):
        line = lines[later]
        if later in stops:
            end, why = later, "anchor"
            break
        if MARKDOWN_HEADING_RE.match(line) and (not level or len(line) - len(line.lstrip("#")) <= level):
            end, why = later, "heading"
            break
        if HRULE_RE.match(line):
            end, why = later, "rule"
            break
        if marker and line.strip() and not line[0].isspace() and not lines[later - 1].strip():
            sibling = LIST_MARKER_RE.match(line)
            if (sibling and bool(sibling.group("num")) == bool(marker.group("num"))) or _section_title(line) \
                    or VERDICT_LINE_RE.search(line):
                end, why = later, "list"
                break
    while end > index + 1 and not lines[end - 1].strip():
        end -= 1
    if end - index > BLOCK_CAP:
        end, why = index + BLOCK_CAP, "cap"
        while end > index + 1 and not lines[end - 1].strip():
            end -= 1
    return end, why


def _family_findings(lines: list[str], records: list[tuple[int, str, str, str, str]]) -> list[FamilyFinding]:
    """Every family anchor in a report, in the order ids are taken: line anchors in line order, then F13 table rows in
    line order. An id the grammar admitted, or an earlier anchor took, is a restatement (the first occurrence is the
    finding, as the dataset's version 1 keeps it; AF-AP-199)."""
    grammar_lines = {record[0] for record in records if record[1]}
    bad_title = {record[0] for record in records if not record[1] and record[4] == "bad-title"}
    grammar_refused = {record[0] for record in records if not record[1]}
    anchors: dict[int, tuple[str, re.Match]] = {}
    for index, line in enumerate(lines):
        if index in grammar_lines or (index in grammar_refused and index not in bad_title):
            continue
        for family, pattern in FAMILY_ANCHORS:
            match = pattern.match(line)
            if match:
                anchors[index] = (family, match)
                break
    tables: list[tuple[int, str, str, str, int]] = []  # (row index, id, class, title cell, class slot end)
    table_heads: set[int] = set()
    index = 0
    while index + 1 < len(lines):
        headers = _split_table_row(lines[index])
        if headers and _is_separator(_split_table_row(lines[index + 1])):
            columns = _f13_columns(headers)
            if columns is not None or _is_grammar_table(headers):
                table_heads.add(index)
            row = index + 2
            while row < len(lines):
                cells = _split_table_row(lines[row])
                if cells is None:
                    break
                if columns is not None and len(cells) >= len(headers):
                    ident, klass, title = columns
                    finding_id = cells[ident].strip().strip("*`").strip()
                    cell = cells[klass].replace("*", "").strip()
                    match = CLASS_START_RE.match(cell)
                    if match and FAMILY_ID_RE.fullmatch(finding_id):
                        slot_end = match.end() if not SLOT_JOINER_RE.match(cell, match.end()) else -1
                        tables.append((row, finding_id, match.group(1), cells[title], slot_end))
                row += 1
            index = row
        else:
            index += 1
    stops = set(anchors) | table_heads | {i for i, line in enumerate(lines) if BULLET_FINDING_RE.match(line)}
    taken = {record[1] for record in records if record[1]}
    out: list[FamilyFinding] = []
    for index, (family, match) in sorted(anchors.items()):
        groups = match.groupdict()
        finding_id = (groups.get("id2") or groups["num"]) if family == "F8" else groups["id"]
        finding_class = groups["cls"]
        end, why = _family_block_end(lines, index, family, stops)
        reason = None
        if finding_id in taken:
            reason = "restated"
        elif SLOT_JOINER_RE.match(lines[index], match.end("cls")):
            reason = "ambiguous-class"
        taken.add(finding_id)
        out.append(FamilyFinding(index, family, finding_id, finding_class,
                                 _family_title(lines, index, match.end(), end), "\n".join(lines[index:end]), why,
                                 reason))
    for row, finding_id, finding_class, title, slot_end in tables:
        reason = "restated" if finding_id in taken else ("ambiguous-class" if slot_end < 0 else None)
        taken.add(finding_id)
        out.append(FamilyFinding(row, "F13", finding_id, finding_class, _collapse(title.replace("**", "")), title,
                                 "cell", reason))
    return out


def _grammar_records(lines: list[str]) -> list[tuple[int, str, str, str, str]]:
    """The grammar's findings and refusals: (line index, id, class, title, block text or row) for an admitted
    finding, (line index, "", "", "", reason) for a refusal. The Laya dataset builder reads the same records."""
    records: list[tuple[int, str, str, str, str]] = []
    anchors: list[int] = [i for i, line in enumerate(lines) if BULLET_FINDING_RE.match(line)]
    for index in anchors:
        match = BULLET_FINDING_RE.match(lines[index])
        assert match is not None
        heading, reason = _heading_text(lines, index)
        if reason:
            records.append((index, "", "", "", reason))
            continue
        assert heading is not None
        prefix = f"{match.group('id')} {match.group('class')} — "
        if prefix not in heading:
            records.append((index, "", "", "", "bad-title"))
            continue
        title = heading.split(prefix, 1)[1]
        end = len(lines)
        for later in range(index + 1, len(lines)):
            if BULLET_FINDING_RE.match(lines[later]) or MARKDOWN_HEADING_RE.match(lines[later]):
                end = later
                break
        records.append(
            (index, match.group("id"), match.group("class"), title, "\n".join(lines[index:end]))
        )

    index = 0
    while index + 1 < len(lines):
        headers = _split_table_row(lines[index])
        if (
            headers
            and len(headers) >= 2
            and headers[0].strip().lower() in {"#", "id"}
            and headers[1].strip().lower() == "class"
            and _is_separator(_split_table_row(lines[index + 1]))
        ):
            title_index = _title_column(headers)
            row_index = index + 2
            while row_index < len(lines):
                cells = _split_table_row(lines[row_index])
                if cells is None:
                    break
                if len(cells) < len(headers):
                    records.append((row_index, "", "", "", "bad-table-row"))
                elif title_index is None:
                    records.append((row_index, "", "", "", "no-title-column"))
                else:
                    finding_id = cells[0].strip()
                    finding_class = _parse_class(cells[1])
                    if not FINDING_ID_RE.fullmatch(finding_id):
                        records.append((row_index, "", "", "", "bad-finding-id"))
                    elif finding_class is None:
                        records.append((row_index, "", "", "", "bad-class"))
                    else:
                        records.append(
                            (row_index, finding_id, finding_class, cells[title_index], lines[row_index])
                        )
                row_index += 1
            index = row_index
        else:
            index += 1
    return records


def _finding_candidates(
    *, source: Source, tree: set[str], registry: dict[str, str]
) -> list[Candidate]:
    lines = _lines(source.text)
    records = _grammar_records(lines)
    family = _family_findings(lines, records)
    family_admitted = {finding.line for finding in family if finding.reason is None}
    grammar_refused = {record[0] for record in records if not record[1]}
    # A family admits a line the grammar refused `bad-title` (F1): the admission replaces that refusal. Every other
    # grammar refusal stays as it was, so a line the grammar refused keeps its reason when no family admits it.
    records = [record for record in records if record[1] or record[0] not in family_admitted]

    candidates: list[Candidate] = []
    lane = _report_lane(source.path)
    for line_index, finding_id, finding_class, title, text_or_reason in sorted(records):
        if not finding_id:
            candidates.append(Candidate(line_index + 1, "", "", "", {}, "", text_or_reason))
            continue
        locator = f"{finding_id} @ {_nearest_heading(lines, line_index)}"
        candidates.append(
            Candidate(
                line=line_index + 1,
                question_id="v1.finding_class",
                producer="adversarial-verifier",
                answer=finding_class,
                state={
                    "lane": lane,
                    "finding_id": finding_id,
                    "title": title,
                    "paths": _report_paths(text_or_reason, tree),
                    "disposition": "BLOCKING" if finding_class in BLOCKING_CLASSES else "NON-BLOCKING",
                },
                locator=locator,
            )
        )
        for row_id in _unique_ap_ids(title if BULLET_FINDING_RE.match(lines[line_index]) else text_or_reason):
            row_title = registry.get(row_id)
            if row_title is None:
                candidates.append(Candidate(line_index + 1, "", "", "", {}, "", "no-registry-row"))
                continue
            candidates.append(
                Candidate(
                    line=line_index + 1,
                    question_id="ap.violates_row",
                    producer="adversarial-verifier",
                    answer="yes",
                    state={
                        "action_kind": "report",
                        "action_target": source.path,
                        "action_excerpt": title,
                        "row_id": row_id,
                        "row_title": row_title,
                    },
                    locator=locator,
                )
            )
    for finding in family:
        if finding.reason == "restated" or (finding.reason and finding.line in grammar_refused):
            continue  # a restatement is neither admitted nor refused; a grammar refusal keeps its own reason
        if finding.reason:
            candidates.append(Candidate(finding.line + 1, "", "", "", {}, "", finding.reason))
            continue
        # As the grammar does: a table row's paths and AF-AP ids come from the row, a line anchor's ids from its title.
        row_text = lines[finding.line] if finding.family == "F13" else finding.text
        locator = f"{finding.finding_id} @ {_nearest_heading(lines, finding.line)}"
        candidates.append(
            Candidate(
                line=finding.line + 1,
                question_id="v1.finding_class",
                producer="adversarial-verifier",
                answer=finding.finding_class,
                state={
                    "lane": lane,
                    "finding_id": finding.finding_id,
                    "title": finding.title,
                    "paths": _report_paths(row_text, tree),
                    "disposition": "BLOCKING" if finding.finding_class in BLOCKING_CLASSES else "NON-BLOCKING",
                },
                locator=locator,
            )
        )
        for row_id in _unique_ap_ids(row_text if finding.family == "F13" else finding.title):
            row_title = registry.get(row_id)
            if row_title is None:
                candidates.append(Candidate(finding.line + 1, "", "", "", {}, "", "no-registry-row"))
                continue
            candidates.append(
                Candidate(
                    line=finding.line + 1,
                    question_id="ap.violates_row",
                    producer="adversarial-verifier",
                    answer="yes",
                    state={
                        "action_kind": "report",
                        "action_target": source.path,
                        "action_excerpt": finding.title,
                        "row_id": row_id,
                        "row_title": row_title,
                    },
                    locator=locator,
                )
            )
    candidates.sort(key=lambda candidate: candidate.line)  # stable: the grammar's rows keep their order
    return candidates


def _strip_rating(value: str) -> str:
    value = value.strip().strip("*").strip()
    value = re.sub(r"^[^A-Za-z0-9]+\s*", "", value)
    return value.upper()


def _rating_answer(headers: tuple[str, ...], cells: list[str]) -> str | None:
    values = dict(zip(headers, cells))
    parsed: dict[str, str] = {}
    for key in ("Urgency", "Risk: Fix", "Risk: No Fix", "ROI", "Effort"):
        value = _strip_rating(values[key])
        if value not in RATINGS[key]:
            return None
        parsed[key] = value.lower()
    blast = _strip_rating(values["Blast"] if "Blast" in values else values["Blast Radius"])
    blast_match = re.fullmatch(r"(1 FILE|[1-9]\d* FILES|[1-9]\d*\+ FILES)", blast)
    if not blast_match:
        return None
    if blast == "1 FILE":
        blast_answer = "1-file"
    elif blast.endswith("+ FILES"):
        blast_answer = blast.split("+", 1)[0] + "-plus-files"
    else:
        blast_answer = blast.split(" ", 1)[0] + "-files"
    return (
        f"urgency={parsed['Urgency']};risk_fix={parsed['Risk: Fix']};"
        f"risk_no_fix={parsed['Risk: No Fix']};roi={parsed['ROI']};"
        f"blast={blast_answer};effort={parsed['Effort']}"
    )


def _parse_lane_report(source: Source) -> list[Candidate]:
    lines = _lines(source.text)
    candidates: list[Candidate] = []
    for index, line in enumerate(lines):
        match = BOUNDARY_RE.match(line)
        if match:
            observed_parts = [match.group("tail").lstrip(" —:*")]
            later = index + 1
            while later < len(lines):
                if not lines[later].strip() or MARKDOWN_HEADING_RE.match(lines[later]) or re.match(r"^(?:[-*+] |\d+\. )", lines[later]):
                    break
                observed_parts.append(lines[later])
                later += 1
            candidates.append(
                Candidate(
                    line=index + 1,
                    question_id="wf.drift",
                    producer="code-implementer",
                    answer="yes",
                    state={
                        "step_id": "boundary-respected",
                        "drift_kind": "out-of-boundary",
                        "expected": "touch only the files the brief names",
                        "observed": _collapse(" ".join(observed_parts)),
                    },
                    locator=f"BOUNDARY DEVIATION @ {_nearest_heading(lines, index)}",
                )
            )

    index = 0
    while index + 1 < len(lines):
        headers_list = _split_table_row(lines[index])
        headers = tuple(headers_list or ())
        if headers in BUG_ECHO_HEADERS and _is_separator(_split_table_row(lines[index + 1])):
            heading = _nearest_heading(lines, index)
            ids = _unique_ap_ids(heading)
            row_index = index + 2
            while row_index < len(lines):
                cells = _split_table_row(lines[row_index])
                if cells is None:
                    break
                locator_id = cells[0] if cells else "?"
                if not ids:
                    candidates.append(Candidate(row_index + 1, "", "", "", {}, "", "no-class-slug"))
                elif len(cells) != len(headers):
                    candidates.append(Candidate(row_index + 1, "", "", "", {}, "", "bad-rating"))
                else:
                    answer = _rating_answer(headers, cells)
                    if answer is None:
                        candidates.append(Candidate(row_index + 1, "", "", "", {}, "", "bad-rating"))
                    else:
                        candidates.append(
                            Candidate(
                                line=row_index + 1,
                                question_id="d1.bug_echo_scores",
                                producer="bug-echo",
                                answer=answer,
                                state={"class_slug": ids[0], "finding_title": cells[1]},
                                locator=f"{locator_id} @ {heading}",
                            )
                        )
                row_index += 1
            index = row_index
        else:
            index += 1
    return candidates


def _content_blocks(record: dict) -> list[dict]:
    message = record.get("message")
    return message.get("content", []) if isinstance(message, dict) and isinstance(message.get("content"), list) else []


def _tool_result_payload(block: dict) -> str | None:
    content = block.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return None
    text_blocks = [item.get("text") for item in content if isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str)]
    if text_blocks and text_blocks[-1].startswith("agentId:"):
        text_blocks.pop()
    return "".join(text_blocks)


def _reviewer_rows(payload: object) -> tuple[list[list[object]] | None, str | None]:
    if not isinstance(payload, dict) or set(payload) != {"c", "r", "n"}:
        return None, "bad-payload"
    if payload["c"] != ["id", "sev", "file", "line", "kind", "msg"] or not isinstance(payload["r"], list) or type(payload["n"]) is not int:
        return None, "bad-payload"
    if payload["n"] != len(payload["r"]):
        return None, "n-mismatch"
    rows = payload["r"]
    if any(
        not isinstance(row, list)
        or len(row) != 6
        or not all(isinstance(row[index], str) and row[index] for index in (0, 1, 2, 4, 5))
        or type(row[3]) is not int
        for row in rows
    ):
        return None, "bad-payload"
    return rows, None


def _scout_rows(payload: object) -> tuple[list[dict] | None, str | None]:
    if not isinstance(payload, dict) or set(payload) != {"hits", "n"}:
        return None, "bad-payload"
    if not isinstance(payload["hits"], list) or type(payload["n"]) is not int:
        return None, "bad-payload"
    if payload["n"] != len(payload["hits"]):
        return None, "n-mismatch"
    required = {"id", "sym", "file", "line", "role"}
    for hit in payload["hits"]:
        if (
            not isinstance(hit, dict)
            or not required.issubset(hit)
            or set(hit) - (required | {"note"})
            or not all(isinstance(hit[key], str) and hit[key] for key in ("id", "sym", "file", "role"))
            or type(hit["line"]) is not int
            or ("note" in hit and not isinstance(hit["note"], str))
        ):
            return None, "bad-payload"
    return payload["hits"], None


def _parse_transcript(source: Source) -> list[Candidate]:
    records: list[dict | None] = []
    candidates: list[Candidate] = []
    for line_number, raw in enumerate(_lines(source.text), 1):
        try:
            value = json.loads(raw)
        except (ValueError, RecursionError):  # JSONDecodeError is a ValueError; deep nesting recurses (S6)
            records.append(None)
            candidates.append(Candidate(line_number, "", "", "", {}, "", "bad-json"))
            continue
        records.append(value if isinstance(value, dict) else None)
        if not isinstance(value, dict):
            candidates.append(Candidate(line_number, "", "", "", {}, "", "bad-json"))

    dispatches: list[tuple[int, str, str]] = []
    for index, record in enumerate(records):
        if record is None or record.get("type") != "assistant":
            continue
        for block in _content_blocks(record):
            if not isinstance(block, dict) or block.get("type") != "tool_use" or block.get("name") not in {"Agent", "Task"}:
                continue
            inputs = block.get("input")
            role = inputs.get("subagent_type") if isinstance(inputs, dict) else None
            tool_id = block.get("id")
            if role in {"hive-scout", "hive-reviewer"}:
                if not isinstance(tool_id, str) or not tool_id:
                    candidates.append(Candidate(index + 1, "", "", "", {}, "", "bad-payload"))
                    continue
                dispatches.append((index, tool_id, role))

    for anchor, tool_id, role in dispatches:
        result: tuple[int, dict, dict] | None = None
        for later in range(anchor + 1, len(records)):
            record = records[later]
            if record is None or record.get("type") != "user":
                continue
            for block in _content_blocks(record):
                if isinstance(block, dict) and block.get("type") == "tool_result" and block.get("tool_use_id") == tool_id:
                    result = (later, record, block)
                    break
            if result:
                break
        if result is None:
            candidates.append(Candidate(anchor + 1, "", "", "", {}, "", "no-result"))
            continue
        result_index, record, block = result
        payload_text = _tool_result_payload(block)
        try:
            payload = json.loads(payload_text) if payload_text is not None else None
        except (ValueError, RecursionError):
            payload = None
        if payload is None:
            candidates.append(Candidate(result_index + 1, "", "", "", {}, "", "bad-payload"))
            continue
        uuid = record.get("uuid")
        if not isinstance(uuid, str) or not uuid:
            candidates.append(Candidate(result_index + 1, "", "", "", {}, "", "bad-payload"))
            continue
        if role == "hive-scout":
            rows, reason = _scout_rows(payload)
            if reason:
                candidates.append(Candidate(result_index + 1, "", "", "", {}, "", reason))
                continue
            assert rows is not None
            for hit in rows:
                if hit["role"] not in ROLE_ANSWERS:
                    candidates.append(Candidate(result_index + 1, "", "", "", {}, "", "unknown-role"))
                    continue
                candidates.append(
                    Candidate(
                        line=result_index + 1,
                        question_id="b2.hit_role",
                        producer="hive-scout",
                        answer=hit["role"],
                        state={"sym": hit["sym"], "file": hit["file"], "snippet": hit.get("note", "")},
                        locator=f"{uuid}#{hit['id']}",
                    )
                )
        else:
            rows, reason = _reviewer_rows(payload)
            if reason:
                candidates.append(Candidate(result_index + 1, "", "", "", {}, "", reason))
                continue
            assert rows is not None
            for finding_id, severity, file_path, _line, finding_kind, message in rows:
                if severity not in SEVERITY_ANSWERS:
                    candidates.append(Candidate(result_index + 1, "", "", "", {}, "", "unknown-sev"))
                    continue
                if not isinstance(finding_kind, str) or not KIND_RE.fullmatch(finding_kind):
                    candidates.append(Candidate(result_index + 1, "", "", "", {}, "", "bad-kind"))
                    continue
                state = {"file": file_path, "kind": finding_kind, "msg": message}
                locator = f"{uuid}#{finding_id}"
                candidates.extend(
                    [
                        Candidate(result_index + 1, "b1.finding_sev", "hive-reviewer", severity, state, locator),
                        Candidate(result_index + 1, "b1.finding_kind", "hive-reviewer", finding_kind, state, locator),
                    ]
                )
    return candidates


def _candidates(source: Source, *, tree: set[str], registry: dict[str, str]) -> list[Candidate]:
    if source.kind == "incident_log":
        return _parse_incident(source, registry)
    if source.kind == "verify_report":
        return _finding_candidates(source=source, tree=tree, registry=registry)
    if source.kind == "lane_report":
        return _parse_lane_report(source)
    return _parse_transcript(source)


def _source_ref(source: Source, locator: str) -> dict:
    return {
        "kind": source.kind,
        "path": source.path,
        "source_digest": source.digest,
        "locator": locator,
    }


def _errno_name(exc: OSError) -> str:
    return errno.errorcode.get(exc.errno, type(exc).__name__)


def _output_invalid(path: str, reason: str) -> int:
    print(f"harvest-output-invalid: {path} ({reason})", file=sys.stderr)
    return 6


def _claim_output(path: str) -> str | None:
    """Lock `--out` and replay it once, before any source is parsed (D-063, D-064 (4); R5 (a)-(b)).

    Returns None, or the refusal reason: `locked`, a `DecisionStateError` code, or an errno name.
    The fd is never closed: the exclusive lock is held until the process exits.
    """
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o644)
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return "decision-ledger-not-regular"
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "locked"
        replay(path)
    except DecisionStateError as exc:
        return exc.reason
    except OSError as exc:
        return _errno_name(exc)
    return None


def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = UsageParser(add_help=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--root", default=str(SCRIPT_ROOT))
    parser.add_argument("sources", nargs="*")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(sys.argv[1:] if argv is None else argv)
    root = _repo_root(args.root)
    commit = _resolve_commit(root) if root is not None else None
    if root is None or commit is None:
        print("decide-harvest: --root is not a git work tree", file=sys.stderr)
        return 64
    output_path = Path(args.out).resolve()
    if output_path == root or root in output_path.parents:
        relative_output = output_path.relative_to(root).as_posix()
        if relative_output and _head_blob(root, commit, relative_output) is not None:
            print(f"harvest-output-source-conflict: {relative_output}", file=sys.stderr)
            return 4
    sources, error = _admit(root, commit, args.sources)
    if error:
        code, message = error
        print(message, file=sys.stderr)
        return code
    assert sources is not None
    claim_error = _claim_output(args.out)
    if claim_error is not None:
        return _output_invalid(args.out, claim_error)

    tree_paths = _tree_paths(root, commit)
    assert tree_paths is not None
    tree = set(tree_paths)
    incident_data = _head_blob(root, commit, "docs/INCIDENT-LOG.md")
    registry = _registry(incident_data.decode("utf-8", "strict")) if incident_data is not None else {}

    counts = {question_id: 0 for question_id in QUESTION_IDS}
    kinds = {kind: 0 for kind in SOURCE_KINDS}
    no_records = 0
    refused: list[Refusal] = []
    skipped = 0

    for source in sources:
        kinds[source.kind] += 1
        parsed = _candidates(source, tree=tree, registry=registry)
        if not parsed:
            no_records += 1
        for candidate in parsed:
            if candidate.reason:
                refusal = Refusal(source.path, candidate.line, candidate.reason)
                refused.append(refusal)
                print(
                    f"harvest-source-unparseable: {refusal.path}:{refusal.line} ({refusal.reason})",
                    file=sys.stderr,
                )
                continue
            try:
                row = make_row(
                    producer=candidate.producer,
                    question_id=candidate.question_id,
                    raw_state=candidate.state,
                    incumbent_answer=candidate.answer,
                    source_ref=_source_ref(source, candidate.locator),
                    root=root,
                )
            except DecisionStateError as exc:
                reason = f"state:{exc.reason}"
                refused.append(Refusal(source.path, candidate.line, reason))
                print(
                    f"harvest-source-unparseable: {source.path}:{candidate.line} ({reason})",
                    file=sys.stderr,
                )
                continue
            try:
                append(args.out, row)
            except DecisionStateError as exc:
                # A skip only for THIS row's own id; `append` raises the same reason for a corrupt ledger (D-063 (2)).
                if exc.reason == "decision-row-duplicate" and exc.detail == row["row_id"]:
                    skipped += 1
                    print(str(exc), file=sys.stderr)
                    continue
                return _output_invalid(args.out, exc.reason)
            except OSError as exc:
                return _output_invalid(args.out, _errno_name(exc))
            counts[candidate.question_id] += 1

    per_type = ", ".join(f"{question_id}={counts[question_id]}" for question_id in QUESTION_IDS)
    print(f"harvest: {sum(counts.values())} rows, per question type: {per_type}")
    print("negatives: 0 (hand-labeled in J2)")
    by_kind = ", ".join(f"{kind}={kinds[kind]}" for kind in SOURCE_KINDS)
    print(
        f"sources: {len(sources)} read ({by_kind}), {no_records} with no records; "
        f"refused: {len(refused)} records; skipped: {skipped} duplicates"
    )
    return 3 if refused else 0


if __name__ == "__main__":
    raise SystemExit(main())
