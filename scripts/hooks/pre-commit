#!/bin/bash
# ROUND-CHURN GATE (owner mandate 2026-09-02, RP-30b rounds 5-6): every .py in
# the index is pyflakes-DELTA checked against HEAD and BLOCKS on NEW hits.
# Orphaned imports, np/pd used without import (AP-61) and caller-only locals
# read inside a helper (AP-60) each cost a whole verify round; each was a
# pyflakes line nobody ran. Delta, not plain lint: pre-existing hits stay
# non-blocking so nobody learns to bypass the hook.
# Bypass (printed, so it shows in review): SKIP_LINT_DELTA=1 git commit ...
REPO_ROOT="$(git rev-parse --show-toplevel)"
# Venv path honours AF_VENV (PC lanes export it; the sandbox default stays). Found by the first
# Hermes lane 2026-09-03: the hardcoded /root path fell back to a pyflakes-less python3 and the
# old early `exit 0` below then skipped EVERY later gate (shell syntax, skill sync).
PY="${AF_VENV:-/root/venv-agent-factory}/bin/python"
[ -x "$PY" ] || PY="python3"
if "$PY" -c "import pyflakes" 2>/dev/null; then
  "$PY" "$REPO_ROOT/scripts/lint_delta.py" --staged
  RC=$?
  if [ "$RC" != "0" ]; then
    echo "COMMIT BLOCKED by lint_delta (rc=$RC) — see NEW hits above." >&2
    exit 1
  fi
else
  # Missing tooling degrades THIS gate only; the gates below still run (they need no pyflakes).
  echo "pre-commit: pyflakes missing in $PY — run scripts/setup.sh (sandbox) or harness-ports/bin/pc-setup.sh (PC). Lint delta SKIPPED, other gates still run." >&2
fi
# AP-67 (2026-09-02): a staged edit to a file a mutation manifest anchors into re-checks
# that manifest's anchors against the index (seconds, no pytest). Without this the
# drifted anchor surfaces only in the gate of record's stage 4, ~50 min in.
# Bypass (printed, so it shows in review): SKIP_ANCHOR_CHECK=1 git commit ...
if [ ! -f "$REPO_ROOT/scripts/mutant_anchor_precommit.py" ]; then
  :  # no mutation-manifest tooling in this repo yet (lives in sandbox-kit/reference-scripts until proofs need it)
elif [ -n "$SKIP_ANCHOR_CHECK" ]; then
  echo "pre-commit: SKIP_ANCHOR_CHECK set — AP-67 anchor check bypassed." >&2
else
  "$PY" "$REPO_ROOT/scripts/mutant_anchor_precommit.py"
  RC=$?
  if [ "$RC" != "0" ]; then
    echo "COMMIT BLOCKED by mutant_anchor_precommit (rc=$RC) — re-pin the manifest in this commit." >&2
    exit 1
  fi
fi
# VENDORED-MANIFEST GATE (2026-09-22 13:5xZ incident): a .claude/ skill edit was committed without regenerating
# sandbox-kit/VENDORED-MANIFEST.md (its rows hash whole vendored trees); CI's ordinary suite was red for four pushes.
# The check hashes the eight vendored trees (measured 0.35 s wall on this tree, 2026-09-22 14:0xZ) and runs ONLY when a
# STAGED path lies under a manifest root (the roots read from the committed manifest's first column, never remembered).
# Fix = 'python3 scripts/vendored_manifest.py --write' and stage the manifest in the same commit. The pre-push hook
# carries the same gate as the backstop. Bypass (printed, so it shows in review): SKIP_MANIFEST_CHECK=1 git commit ...
if [ -z "${SKIP_MANIFEST_CHECK:-}" ] && [ -f "$REPO_ROOT/scripts/vendored_manifest.py" ] && [ -f "$REPO_ROOT/sandbox-kit/VENDORED-MANIFEST.md" ]; then
  _MROOTS=$(grep -oE '^\| `[^`]+` \|' "$REPO_ROOT/sandbox-kit/VENDORED-MANIFEST.md" | sed -E 's/^\| `//; s/` \|$//')
  _MSTAGED=$(git diff --cached --name-only)
  _MTOUCHED=""
  for r in $_MROOTS; do
    if printf '%s\n' "$_MSTAGED" | awk -v r="$r" 'index($0, r) == 1 { f = 1 } END { exit !f }'; then _MTOUCHED="$_MTOUCHED $r"; fi
  done
  if [ -n "$_MTOUCHED" ]; then
    if ! (cd "$REPO_ROOT" && "$PY" scripts/vendored_manifest.py --check >&2); then
      echo "COMMIT BLOCKED: a staged path lies under vendored root(s):$_MTOUCHED but sandbox-kit/VENDORED-MANIFEST.md does not match the tree — run 'python3 scripts/vendored_manifest.py --write' and stage the manifest in this commit (AF-AP-56's general form; incident 2026-09-22 13:5xZ)." >&2
      exit 1
    fi
  fi
elif [ -n "${SKIP_MANIFEST_CHECK:-}" ]; then
  echo "pre-commit: SKIP_MANIFEST_CHECK set — the vendored-manifest gate bypassed." >&2
fi
# CLASS-PIN GATE (2026-09-24 12:5xZ, AF-AP-185): tests/test_vendored_manifest.py pins the .claude/ class counts and the
# kit-adapted path list. An edit that moves a file between classes (a kit file edited in place becomes kit-adapted)
# passes the manifest gate above after '--write', but the pinned tests go red in CI: 2026-09-23 (D-054), and again
# 2026-09-24 when wiki-context.py moved (cf026a9, pushed red). When the staged class file's class counts differ from
# HEAD's, the two pinned tests run here and block on red. Bypass (printed): SKIP_CLASS_PIN_CHECK=1 git commit ...
_CLS="sandbox-kit/VENDORED-CLAUDE-CLASSES.tsv"
if [ -z "${SKIP_CLASS_PIN_CHECK:-}" ] && git diff --cached --name-only | grep -qx "$_CLS"; then
  _OLD=$(git show "HEAD:$_CLS" 2>/dev/null | cut -f2 | sort | uniq -c)
  _NEW=$(git show ":$_CLS" 2>/dev/null | cut -f2 | sort | uniq -c)
  if [ "$_OLD" != "$_NEW" ]; then
    echo "pre-commit: the .claude/ class counts changed — running the pinned class tests" >&2
    if ! (cd "$REPO_ROOT" && "$PY" -m pytest -q -p no:cacheprovider tests/test_vendored_manifest.py \
          -k "test_real_claude_split_counts_and_class_file or test_k1h_claude_classification_and_remainder" >&2); then
      echo "COMMIT BLOCKED: the class counts in $_CLS changed and tests/test_vendored_manifest.py still pins the old ones — update ADAPTED_PATHS and the counts, stage the test with this commit (AF-AP-185)." >&2
      exit 1
    fi
  fi
elif [ -n "${SKIP_CLASS_PIN_CHECK:-}" ]; then
  echo "pre-commit: SKIP_CLASS_PIN_CHECK set — the class-pin gate bypassed." >&2
fi
# SKILL-SYNC GATE (2026-09-03): a lesson baked into .claude/skills/ left its .agents/skills/
# twin stale until the final sweep caught it. If any .claude/skills/ path is staged, the two
# trees must agree (harness-ports/bin/sync-skills.sh --check). Fix = run the sync, stage both.
if git diff --cached --name-only | grep -q '^\.claude/skills/' \
   && [ -x "$REPO_ROOT/harness-ports/bin/sync-skills.sh" ]; then
  if ! bash "$REPO_ROOT/harness-ports/bin/sync-skills.sh" --check >/dev/null 2>&1; then
    echo "COMMIT BLOCKED: .claude/skills changed but .agents/skills is out of sync — run 'bash harness-ports/bin/sync-skills.sh' and stage .agents/skills too." >&2
    exit 1
  fi
fi
# MIRROR GATE (2026-09-15, owner: "claude.md properly copied into the agents.md"): a staged
# CLAUDE.md / AGENTS.md / .hermes.md must keep section parity, the size caps (Hermes chars,
# Codex bytes) and the standing-rules hash — harness-ports/tests/test_context_mirrors.sh --check.
# Bypass (printed, so it shows in review): SKIP_MIRROR_CHECK=1 git commit ...
if [ -z "${SKIP_MIRROR_CHECK:-}" ] && git diff --cached --name-only | grep -qxE 'CLAUDE\.md|AGENTS\.md|\.hermes\.md' \
   && [ -f "$REPO_ROOT/harness-ports/tests/test_context_mirrors.sh" ]; then
  if ! out="$(bash "$REPO_ROOT/harness-ports/tests/test_context_mirrors.sh" --check 2>&1)"; then
    echo "COMMIT BLOCKED by the MIRROR gate — CLAUDE.md and its ports (AGENTS.md, .hermes.md) disagree:" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi
fi

# LANE-SKILLS GATE (2026-09-03): .agents/lane-skills/ is the curated subset lanes load; it must
# mirror .agents/skills/ for every name in harness-ports/lane-skills.txt.
if git diff --cached --name-only | grep -qE '^(\.agents/skills/|\.agents/lane-skills/|harness-ports/lane-skills\.txt)' \
   && [ -x "$REPO_ROOT/harness-ports/bin/sync-lane-skills.sh" ]; then
  if ! bash "$REPO_ROOT/harness-ports/bin/sync-lane-skills.sh" --check >/dev/null 2>&1; then
    echo "COMMIT BLOCKED: .agents/lane-skills is out of sync with .agents/skills — run 'bash harness-ports/bin/sync-lane-skills.sh' and stage .agents/lane-skills too." >&2
    exit 1
  fi
fi
# SHELL SYNTAX GATE (2026-09-03): a ported hook shipped with a syntax-error tail
# after its `exit 0` — bash reads scripts incrementally, so runtime never saw it,
# review never saw it, `bash -n` does. Every staged shell script must parse.
for F in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$F" in
    *.sh|scripts/hooks/*) ;;
    *) continue ;;
  esac
  [ -f "$REPO_ROOT/$F" ] || continue
  head -1 "$REPO_ROOT/$F" | grep -q 'sh$\|sh ' || continue
  if ! bash -n "$REPO_ROOT/$F"; then
    echo "COMMIT BLOCKED: bash -n failed on $F — fix the syntax (unreachable tails count)." >&2
    exit 1
  fi
done
# FUTURE-STAMP GATE (2026-09-23, AF-AP-37's timestamp half, second bite): a NEW date-prefixed
# stamp in a staged ledger-plane file (the ledger, the incident log, wiki live-state, the decision
# log) must not name an instant later than the clock; stamps are pasted from date -u or the commit
# clock, never typed. Bypass (printed, so it shows in review): SKIP_STAMP_CHECK=1 git commit ...
if [ -n "${SKIP_STAMP_CHECK:-}" ]; then
  echo "pre-commit: SKIP_STAMP_CHECK set — the future-stamp gate bypassed." >&2
else
  "$PY" "$REPO_ROOT/scripts/stamp_check.py" --staged
  RC=$?
  if [ "$RC" != "0" ]; then
    echo "COMMIT BLOCKED by the future-stamp gate (rc=$RC) — paste the stamp from date -u or the commit clock." >&2
    exit 1
  fi
fi
# SHELL AP SCREEN (task #245, 2026-09-24): the edit-snapshot hook returns early for a non-.py file, so a registered
# shell signature (AF-AP-145, met twice in scripts/gpu_window.sh) never reached its author. Advisory: the hits of
# the staged *.sh files are printed, never blocking; silent when there is none.
"$PY" "$REPO_ROOT/scripts/ap_screen.py" --staged-shell || true
# ADVISORY-EXCLUSION SCREEN (KC-J1): forbidden vocabulary must never appear
# in any gate-defining file. No bypass — this is an absorbing barrier.
"$PY" "$REPO_ROOT/scripts/no_laya_in_gates.py" --staged
RC=$?
if [ "$RC" != "0" ]; then
  echo "COMMIT BLOCKED by the never-a-gate screen (rc=$RC)" >&2
  exit 1
fi
exit 0
