#!/bin/bash
# HOOKS-QUARTET: wiki-freshness gate. WARN mode by default; flips to BLOCK
# when .git/wiki-gate-block exists (arm it once the per-commit wiki cadence is
# proven workable post-WIKI-AUDIT — owner wants the wiki never stale).
REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"  # worktree-safe (2026-09-03)
MARKER="$COMMON_DIR/wiki-stale"
if [ -f "$MARKER" ]; then
  SINCE="$(cat "$MARKER")"
  if [ -f "$COMMON_DIR/wiki-gate-block" ]; then
    echo "PUSH BLOCKED: wiki stale since commit $SINCE — update wiki/ (or remove .git/wiki-gate-block to downgrade to warn)." >&2
    exit 1
  fi
  echo "WARNING: wiki stale since commit $SINCE — code moved without a wiki update (owner mandate 2026-08-25: wiki tracks every commit)." >&2
fi

# TRAILER GATE (incident 2026-08-28): a 4-commit stack reached origin carrying
# model-identifier trailers because a push bypassed scripts/push_clean.sh.
# BLOCK any outgoing commit that still carries them — push_clean.sh strips
# them and is the only sanctioned push path for claude/clean-build.
ZERO=0000000000000000000000000000000000000000
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue  # branch deletion
  # A NEW ref (a tag, a new branch: rsha is ZERO) sends only what origin does not already have — never the whole
  # history behind it (2026-09-08: the first signed `accepted/S0-11` tag push was blocked by 22 trailer lines in
  # commits that were already on origin for days, AF-AP-69).
  if [ "$rsha" = "$ZERO" ]; then set -- "$lsha" --not --remotes=origin; else set -- "$rsha..$lsha"; fi
  RANGE="$*"
  # F-F: capture git log's exit code separately so an unresolvable range
  # BLOCKS (the old pipe swallowed the error via 2>/dev/null and grep -c
  # returned 0, letting the push through).
  LOG_OUTPUT=$(git log "$@" --format='%B' 2>&1)
  LOG_RC=$?
  if [ "$LOG_RC" != "0" ]; then
    echo "PUSH BLOCKED: git log failed on range $RANGE (rc=$LOG_RC) — cannot verify trailers. Resolve the range before pushing." >&2
    exit 1
  fi
  HITS=$(echo "$LOG_OUTPUT" | grep -c 'Co-Authored-By: Claude\|Claude-Session:' || true)
  if [ "${HITS:-0}" != "0" ]; then
    echo "PUSH BLOCKED: $HITS model-identifier trailer line(s) in outgoing range — push via scripts/push_clean.sh (strips them), never raw git push." >&2
    exit 1
  fi
  # VENDORED-MANIFEST GATE (2026-09-22 13:5xZ incident): a .claude/ skill edit reached origin without regenerating
  # sandbox-kit/VENDORED-MANIFEST.md (its rows hash whole vendored trees) and CI's ordinary suite was red for four pushes.
  # The check hashes eight vendored trees (measured 0.35 s wall on this tree, 2026-09-22 14:0xZ), and runs ONLY when the outgoing range touches a manifest root; the roots
  # are read from the committed manifest's first column, never remembered. A drift BLOCKS: regenerate with --write in
  # the same increment as the vendored change (AF-AP-56's general form: a generated artifact follows its inputs).
  if [ -f "$REPO_ROOT/scripts/vendored_manifest.py" ] && [ -f "$REPO_ROOT/sandbox-kit/VENDORED-MANIFEST.md" ]; then
    ROOTS=$(grep -oE '^\| `[^`]+` \|' "$REPO_ROOT/sandbox-kit/VENDORED-MANIFEST.md" | sed -E 's/^\| `//; s/` \|$//')
    CHANGED=$(git log "$@" --name-only --format= 2>/dev/null | sort -u)
    TOUCHED=""
    for r in $ROOTS; do
      if printf '%s\n' "$CHANGED" | awk -v r="$r" 'index($0, r) == 1 { f = 1 } END { exit !f }'; then TOUCHED="$TOUCHED $r"; fi
    done
    if [ -n "$TOUCHED" ]; then
      echo "pre-push: outgoing range $RANGE touches vendored root(s):$TOUCHED — running the manifest check" >&2
      if ! (cd "$REPO_ROOT" && python3 scripts/vendored_manifest.py --check >&2); then
        echo "PUSH BLOCKED: sandbox-kit/VENDORED-MANIFEST.md drifted from the tree — run 'python3 scripts/vendored_manifest.py --write' and commit it in the same increment as the vendored change (AF-AP-56's general form; incident 2026-09-22 13:5xZ)." >&2
        exit 1
      fi
    fi
  fi
done
exit 0
