.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.sqlite
*.sqlite3
*.db
*.log
# committed evidence bundles are fixtures — their logs ARE the evidence (AF-AP-62, 2026-09-08: 16 buzzacp.log files under
# proofs/S0-02/fixtures/evidence-*/ were swallowed by the rule above; the lane's copy was green, the git-view copy red)
!proofs/*/fixtures/**/*.log
# …and the REAL evidence roots too (VERIFY-B1 F4, 2026-09-08): the checker requires buzzacp.log in every captured leg
!proofs/*/evidence/**/*.log
*.pid
# the same class for pidfiles (2026-09-21, the v2.4 recapture): `buzz-acp.pid` is a REQUIRED leg file (pins.PINNED_LEG_FILES;
# check_runtime_identity binds buzz_acp_pid to it) — five legs' pidfiles were silently ignored by the rule above
!proofs/*/evidence/**/buzz-acp.pid
.DS_Store
.idea/
.vscode/
.pytest_cache/
__pycache__/
node_modules/
target/
dist/
build/
coverage/
.coverage
secrets/
data/
runtime/
vendor/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.ignore
.pc-bridge.env

# PC-lane scratch (spawn path writes per-lane logs/reports here; ported from the source repo)
/.lanes/

# sentrux (advisory instrument) runtime: composed scan tree + baseline — regenerable, never committed
/.sentrux-runtime/

# pc_suite.sh run dirs on the PC clone (patch, worktree, log, rc) — regenerable, never committed
/.suite/
/.lanes-live

# the S0-01 pinned-upstream oracle (crates/buzz-acp/src/acp.rs at 1c8321cd, sha-pinned in its VENDORED-FROM.md) is committed on purpose
!proofs/S0-01/vendor/

# super-hermes prism growth-loop constraint log (per-project, not tracked)
.prism-history.md

# Ouroboros MCP server state written into the project cwd (artifacts.db + WAL) by scripts/ooo_mcp.py runs — tool state, never project content (2026-09-22)
.ouroboros/
