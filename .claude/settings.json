{
  "enabledMcpjsonServers": [
    "gitnexus",
    "aleph",
    "codebase-memory",
    "ouroboros",
    "phoenix-docs"
  ],
  "permissions": {
    "allow": [
      "mcp__ouroboros",
      "mcp__gitnexus",
      "mcp__codebase-memory",
      "mcp__aleph",
      "mcp__phoenix-docs",
      "mcp__github",
      "mcp__Context7",
      "mcp__Exa",
      "mcp__Eraser",
      "mcp__Lucid",
      "mcp__SlidesGPT",
      "mcp__claude-code-remote",
      "mcp__Claude_Code_Remote",
      "Workflow",
      "Agent",
      "Task"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/scripts/task_sync.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/task_sync.py --hook session-start",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/scripts/ls_req.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/ls_req.py session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/hook_context.py PostToolUse -- python3 $CLAUDE_PROJECT_DIR/.claude/hooks/edit-snapshot.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/.claude/hooks/wiki-context.py ] && [ -f $CLAUDE_PROJECT_DIR/scripts/hook_context.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/hook_context.py UserPromptSubmit -- python3 $CLAUDE_PROJECT_DIR/.claude/hooks/wiki-context.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/.claude/hooks/system1-context.py ] && [ -f $CLAUDE_PROJECT_DIR/scripts/hook_context.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/hook_context.py UserPromptSubmit -- python3 $CLAUDE_PROJECT_DIR/.claude/hooks/system1-context.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/scripts/ls_req.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/ls_req.py prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/turn-retro-gate.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/scripts/task_sync.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/task_sync.py --hook stop",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/scripts/ls_req.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/ls_req.py stop",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/.claude/hooks/search-intercept.py ] && [ -f $CLAUDE_PROJECT_DIR/scripts/hook_context.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/hook_context.py PreToolUse -- python3 $CLAUDE_PROJECT_DIR/.claude/hooks/search-intercept.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $CLAUDE_PROJECT_DIR/.claude/hooks/system1-context.py ] && [ -f $CLAUDE_PROJECT_DIR/scripts/hook_context.py ] || exit 0; python3 $CLAUDE_PROJECT_DIR/scripts/hook_context.py PreToolUse -- python3 $CLAUDE_PROJECT_DIR/.claude/hooks/system1-context.py"
          }
        ]
      }
    ]
  },
  "outputStyle": "Attention-kind"
}
