+def test_probe_framedir_oder_directory_makes_the_open_raise_not_return(tmp_path):
+    """Round 14 item 1, kill (a), at the open call.
+
+    A regular file at the framedir path with the probe's EXACT framedir flag set
+    (which includes O_DIRECTORY) makes os.open raise ENOTDIR instead of handing
+    the probe a non-directory fd.  Dropping O_DIRECTORY from the same open lets it
+    succeed — proving the flag, not the two realpath checks, is what refuses.
+    The black-box dir->file swap the brief names is NOT landable on this host
+    (the isdir->os.open window is microseconds; see the DISCREPANCIES line).
+    """
+    file = tmp_path / "framedir"
+    file.write_text("i am a file, not a directory")
+    tokens = _probe_framedir_flags()
+    assert "os.O_DIRECTORY" in tokens, tokens
+    assert "os.O_NOFOLLOW" in tokens, tokens
+    assert "os.O_CLOEXEC" in tokens, tokens
+
+    flags = 0
+    for tok in tokens:
+        flags |= getattr(os, tok.removeprefix("os."))
+
+    with pytest.raises(OSError) as ei:
+        fd = os.open(str(file), flags)
+    assert ei.value.errno == errno.ENOTDIR, (
+        f"expected ENOTDIR ({errno.ENOTDIR}), got {ei.value.errno}")
+
+    no_dir = 0
+    for tok in tokens:
+        if tok != "os.O_DIRECTORY":
+            no_dir |= getattr(os, tok.removeprefix("os."))
+    fd = os.open(str(file), no_dir)
+    try:
+        assert stat.S_ISREG(os.fstat(fd).st_mode), "without O_DIRECTORY the same open succeeds"
+    finally:
+        os.close(fd)
+
