+def _probe_framedir_flags():
+    """The framedir open's flag set, extracted from the probe source.
+
+    The flag-mirror tests OPEN with these flags rather than re-typing them, so a
+    mutation of the probe's flag set (dropping O_DIRECTORY / O_CLOEXEC) is caught
+    here, not merely in a source-substring assertion.
+    """
+    import ast as _ast
+    import re as _re
+    src = PROBE.read_text()
+    m = _re.search(r"framedir_fd = os\.open\((.*?)\)\s*\n", src, _re.S)
+    assert m, "could not locate the framedir os.open"
+    stmt = _ast.parse(m.group(1).strip()).body[0]
+    assert isinstance(stmt, _ast.Expr), "the framedir flag set is not a plain expression"
+    flags_node = stmt.value
+    tokens = []
+    for n in _ast.walk(flags_node):
+        if isinstance(n, _ast.Attribute) and n.attr.startswith("O_"):
+            tokens.append("os." + n.attr)
+    return tokens
+
