+def _open_regular_read(path):
+    """Open one file for a bounded, verified read (AF-AP-70 closed for reads).
+
+    The mirror of `_open_regular` on the read side: open -> fstat -> validate ->
+    use, NEVER stat-then-open.  The old shape proved what the NAME was at t0 and
+    trusted the name at t1; a FIFO swapped in between the two blocks the BLOCKING
+    open() forever (the AF-AP-70 read race; the write side was already closed in
+    round 11, this closes the read side).  O_NOFOLLOW makes a final-component
+    symlink raise ELOOP at the open, and O_NONBLOCK makes the open return
+    immediately on a FIFO instead of blocking (a read-open of a FIFO does NOT
+    raise ENXIO — measured: it returns a live descriptor — so the refusal is not
+    the open).  The worker is S_ISREG on the OPEN DESCRIPTOR: it refuses whatever
+    was actually opened, a FIFO, a character device (/dev/zero never reaches
+    EOF), a socket, or a directory.  The fd is closed on every refusal — a
+    refused read must leave no descriptor behind.  Every read the probe performs
+    goes through this one primitive: the probe's own file, the agent entrypoint,
+    the child interpreter, and the fixture."""
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    try:
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode):
+            raise OSError("not a regular file: %s" % (path,))
+        fcntl.fcntl(fd, fcntl.F_SETFL,
+                    fcntl.fcntl(fd, fcntl.F_GETFL) & ~os.O_NONBLOCK)
+    except Exception:
+        os.close(fd)
+        raise
+    return os.fdopen(fd, "rb")
+
