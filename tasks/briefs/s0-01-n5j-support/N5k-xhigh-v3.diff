+@pytest.mark.parametrize("shape", ["fifo", "symlink_loop", "directory", "missing"])
+def test_probe_read_primitive_refuses_non_regular_shapes_by_name(tmp_path, shape):
+    """Round 14 item 3, red: every non-regular shape is refused by its exact reason.
+
+    The worker never opens a FIFO for reading (that is the hang), so these shapes
+    are safe in-process: the primitive's os.open + fstat refuses before any read.
+    A symlink final component is refused at the open by O_NOFOLLOW (ELOOP); a FIFO,
+    a directory, and a missing path are refused by their own reason.  All four are
+    the READ-side mirror of the write-side refusals already pinned for _open_regular.
+    """
+    if shape == "fifo":
+        target = tmp_path / "pipe"
+        os.mkfifo(str(target))
+        msg = f"not a regular file: {target}"
+    elif shape == "symlink_loop":
+        target = tmp_path / "link"
+        os.symlink(str(target), str(target))
+        msg = f"[Errno {errno.ELOOP}]"
+    elif shape == "directory":
+        target = tmp_path / "d"
+        target.mkdir()
+        msg = f"not a regular file: {target}"
+    else:
+        target = tmp_path / "absent"
+        msg = f"[Errno {errno.ENOENT}]"
+
+    with pytest.raises(OSError) as ei:
+        _probe_mod._open_regular_read(str(target))
+    assert msg in str(ei.value), (str(ei.value), msg)
