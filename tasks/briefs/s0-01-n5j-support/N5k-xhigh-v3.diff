+        "    try:\n        st = os.fstat(fd)\n        fcntl.fcntl(fd, fcntl.F_SETFL,\n                    fcntl.fcntl(fd, fcntl.F_GETFL) & ~os.O_NONBLOCK)\n    except Exception:\n        os.close(fd)\n        raise")
+    assert nisreg != src
+    body_nisreg = nisreg.split("def _open_regular_read", 1)[1].split("\ndef ", 1)[0]
+    # The guard is the code form `stat.S_ISREG(st.st_mode)`; the docstring's bare
+    # "S_ISREG" is prose and stays.  Assert the guard itself is gone.
+    assert "stat.S_ISREG" not in body_nisreg
+
+    # INVENTORY-READER-MISSING: a planted read in a brand-new function.
+    planted = src.replace(
+        "def _sha256_file(path):",
+        "def _planted_reader(path):\n    with open(path, 'rb') as f:\n        f.read()\n\n\ndef _sha256_file(path):")
+    assert planted != src
+    assert _scan_file_receivers(planted) != _RECEIVER_INVENTORY
+
+
+# ---- Round 14 item 2: the inherited-fd attack (O_CLOEXEC) ----
+#
+# The census agent walks /proc/self/fd and counts directory fds whose realpath is
+# the framedir, writing "CENSUS=N" to $S0_01_CENSUS_OUT.  It is ONE agent, used two
+# ways: in ACP mode (S0_01_ACP=1) it also answers initialize so the probe completes
+# cleanly through the real emitter; in plain mode it just writes the census and
+# exits, so the isolated F_SETFD driver can exec it directly.
+_CENSUS_AGENT = """#!%s
+import json, os, sys
+frame = os.environ.get("S0_01_FRAMEDIR")
+out = os.environ.get("S0_01_CENSUS_OUT")
+n = 0
+if frame:
+    fr = os.path.realpath(frame)
+    for e in os.listdir("/proc/self/fd"):
+        try:
+            t = os.readlink("/proc/self/fd/" + e)
+        except OSError:
+            continue
+        try:
+            if os.path.isdir(t) and os.path.realpath(t) == fr:
+                n += 1
+        except OSError:
+            pass
+if out:
+    with open(out, "w") as f:
+        f.write("CENSUS=%%d\\n" %% n)
+if os.environ.get("S0_01_ACP") == "1":
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        msg = json.loads(line)
+        if msg.get("method") == "initialize":
+            sys.stdout.write(json.dumps({
+                "jsonrpc": "2.0", "id": msg["id"],
+                "result": {"protocolVersion": 1,
+                           "agentInfo": {"name": "census", "version": "0"},
+                           "agentCapabilities": {}}}) + "\\n")
+            sys.stdout.flush()
+        break
+    sys.stdin.read()
+"""
+
+
+def _census_count(out_file):
+    return int(out_file.read_text().strip().split("=")[1])
+
+
+def test_probe_census_agent_sees_no_framedir_fd_on_final_bytes(tmp_path, agent_result):
+    """Round 14 item 2, red/green on the final bytes: the census agent, launched
+    through the probe like every other fixture agent, sees NO directory fd pointing
+    at the framedir.  The probe opens the framedir with O_CLOEXEC (probe:331) AND
+    pins close_fds=True (probe:390); the agent's own fd table is the assertion,
+    never the flag alone.
+    """
+    agent = tmp_path / "census_agent.py"
+    agent.write_text(_CENSUS_AGENT % sys.executable)
+    agent.chmod(0o755)
+    out_file = tmp_path / "census.txt"
+    r, framedir = _run_probe(
+        tmp_path, str(agent),
+        extra_env={"S0_01_CENSUS_OUT": str(out_file), "S0_01_ACP": "1"})
+    assert r.returncode == 0, f"probe failed: {r.returncode}: {r.stderr}"
+    assert out_file.exists(), f"census not written: {r.stderr}"
+    assert _census_count(out_file) == 0, (
+        f"inherited framedir fd seen by the agent: {out_file.read_text()!r}")
+
+
+def test_probe_census_isolated_fsetfd_negative_control(tmp_path):
+    """Round 14 item 2, the negative control (Amendment 2).  The brief's original
+    control — the same agent reporting ONE on the CLOEXEC-DROPPED mutant through the
+    REAL emitter — does not reproduce: the Popen pins close_fds=True (probe:390), the
+    second independent defence, so the fd is closed at exec regardless of the bit and
+    the real-emitter census reads 0 (measured; see DISCREPANCIES).  The flag's own
+    teeth are therefore proven in isolation, where the CLOEXEC bit is the SOLE
+    decider (the exec does not use close_fds): bit set -> the child sees 0, bit
+    cleared -> the child sees 1.  That is the load-bearing proof.
+    """
+    framedir = tmp_path / "frame"
+    framedir.mkdir()
+    agent = tmp_path / "census_agent.py"
+    agent.write_text(_CENSUS_AGENT % sys.executable)
+    agent.chmod(0o755)
+    driver = tmp_path / "census_driver.py"
+    driver.write_text(textwrap.dedent("""
+        import fcntl, os, sys
+        framedir, bit, agent, out = sys.argv[1:5]
+        r, w = os.pipe()
+        pid = os.fork()
+        if pid == 0:
+            os.close(r)
+            fd = os.open(framedir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+            if bit == "set":
+                fcntl.fcntl(fd, fcntl.F_SETFD, fcntl.FD_CLOEXEC)
+            else:
+                fcntl.fcntl(fd, fcntl.F_SETFD, 0)
+            os.dup2(w, 1)
+            os.close(w)
+            env = dict(os.environ)
+            env["S0_01_FRAMEDIR"] = framedir
+            env["S0_01_CENSUS_OUT"] = out
+            os.execvpe(sys.executable, [sys.executable, agent], env)
+            os._exit(127)
+        os.close(w)
+        while True:
+            b = os.read(r, 4096)
+            if not b:
+                break
+        os.close(r)
+        _, status = os.waitpid(pid, 0)
+        sys.exit(os.waitstatus_to_exitcode(status))
+    """))
+    results = {}
+    for bit in ("set", "cleared"):
+        out_file = tmp_path / f"census_{bit}.txt"
+        if out_file.exists():
+            out_file.unlink()
+        r = subprocess.run(
+            ["timeout", "15", sys.executable, str(driver), str(framedir), bit,
+             str(agent), str(out_file)],
+            capture_output=True, text=True, timeout=20)
+        assert r.returncode == 0, f"driver {bit}: rc={r.returncode} {r.stderr}"
+        assert out_file.exists(), f"no census for {bit}: {r.stderr}"
+        results[bit] = _census_count(out_file)
+    # The bit is the sole decider: set closes the fd (0), cleared keeps it (1).
+    assert results["set"] == 0, f"bit set should close the fd, saw {results}"
+    assert results["cleared"] == 1, f"bit cleared should leak the fd, saw {results}"
