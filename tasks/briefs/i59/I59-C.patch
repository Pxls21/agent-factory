+# I59-C (VERIFY-S0-04-LEAK-R1 G6): the tail's bound is FOUR `_` segments after the listed word. A name with four is a
+# key; a fifth passes, by design (the bound keeps a run of names linear). The cases above pin "at least 2" only, so a
+# bound of 2, 3 or 5 survived them. Tests only: the rule does not change.
+def _tailed_name(segments):
+    return "API_KEY" + "".join(f"_S{i}" for i in range(1, segments + 1))
+
+
+@pytest.mark.parametrize("segments", [4, 5])
+def test_the_checker_bounds_a_key_name_tail_at_four_segments(tmp_path, segments):
+    value = secrets.token_hex(16)
+    code, out = run_checker(_with_note(tmp_path, "b", "stray_note", f"{_tailed_name(segments)}={value}"))
+    if segments == 4:
+        assert code == 1, out
+        assert out.splitlines() == ["failure_reason: credential-in-evidence: off/request.json matches key-assignment"], out
+        assert value not in out, "the checker echoed the fake value it rejected"
+    else:
+        assert code == 0, out
+        assert PASS_LINE in out.splitlines(), out
+
