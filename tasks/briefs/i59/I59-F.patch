+    assert ignored(bare) == {signal.SIGINT, signal.SIGHUP, signal.SIGQUIT}, bare.stdout
+    assert shimmed.stdout.splitlines()[:3] == ["trap -- 'exit 91' SIGINT", "trap -- 'exit 92' SIGHUP",
