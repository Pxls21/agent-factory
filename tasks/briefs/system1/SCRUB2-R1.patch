+# AF-AP-152, VERIFY-SCRUB2 F7: the lenient key-block rule retried `-{3,}` at every dash of a run and scanned to the end of
+# the text from every BEGIN head with no END (over 20 s on 60,000 dashes; 0.014 s before SCRUB2), and the Cookie rule read
+# the rest of its line from every head (2.7 s on 64,000 characters). A child times each scrub on each hostile text; every
+# call must take under 2 s (the rules take under 0.1 s), and a stall fails the test at the child's timeout.
+LINEAR_CHILD = r"""
+import importlib.util, sys, time
+spec = importlib.util.spec_from_file_location("transcript_export_linear", sys.argv[1])
+te = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(te)
+head = "----BEGIN RSA PRIVATE KEY----\n"
+texts = [("60,000 dashes", "-" * 60000), ("60,000 dashes, then BEGIN", "-" * 60000 + "BEGIN RSA PRIVATE KEY----\nzq"),
+         ("4,000 BEGIN heads, no END", head * 4000), ("a BEGIN head, then 60,000 dashes", head + "-" * 60000),
+         ("12,000 cookie heads on a line", "cookie: x " * 12000), ("11,000 Set-Cookie heads", "Set-Cookie:" * 11000)]
+for name, text in texts:
+    for fn in (te.scrub, te.scrub_payload):
+        t0 = time.perf_counter()
+        fn(text)
+        print("%s|%s|%.4f" % (name, fn.__name__, time.perf_counter() - t0), flush=True)
+"""
+
+
+def test_the_key_block_and_cookie_rules_run_in_linear_time():
+    try:
+        r = subprocess.run([sys.executable, "-c", LINEAR_CHILD, str(TOOL)], capture_output=True, text=True, timeout=40)
+    except subprocess.TimeoutExpired as e:
+        pytest.fail("a scrub stalled on a hostile text; the calls that finished: %s" % (e.stdout or b"").decode()[-400:])
+    assert r.returncode == 0, r.stderr[-400:]
+    rows = [line.split("|") for line in r.stdout.splitlines()]
+    assert len(rows) == 12 and [(n, f, s) for n, f, s in rows if float(s) >= 2.0] == []
+
+
+# The lenient rule as SCRUB2 wrote it (cdbc1b8:scripts/transcript_export.py:81-83): SCRUB2-R1 changes its speed, not what it
+# hides. The generator's alphabet: whole malformed heads and END lines (3, 4 and spaced dashes, PGP BLOCK), loose dashes
+# (1, 2, 3 and 5), their words alone, spaces, tabs, newlines and filler. It cannot draw a 5-dash head (the strict rule's),
+# lower case, or a head split over two lines.
+PIN_KEY_BLOCK = re.compile(r"-{3,}[ \t]*BEGIN [A-Z0-9 ]*(?:PRIVATE|SECRET) KEY(?: BLOCK)?[ \t]*-{3,}.*?"
+                           r"-{3,}[ \t]*END [A-Z0-9 ]*(?:PRIVATE|SECRET) KEY(?: BLOCK)?[ \t]*-{3,}", re.S)
+KEY_BLOCK_WORDS = ("----BEGIN RSA PRIVATE KEY----", "---BEGIN PRIVATE KEY---", "--- BEGIN EC PRIVATE KEY ---",
+                   "----BEGIN PGP PRIVATE KEY BLOCK----", "----END RSA PRIVATE KEY----", "---END PRIVATE KEY---",
+                   "--- END EC PRIVATE KEY ---", "----END PGP PRIVATE KEY BLOCK----", "-", "--", "---", "-----", " ", "\t",
+                   "\n", "BEGIN ", "END ", "PRIVATE KEY", "SECRET KEY", "zq", "AbC0+/=")
+
+
+def test_the_lenient_key_block_rule_hides_what_scrub2s_rule_hid():
+    p, r = [pr for pr in MOD.SECRET_PATTERNS if "BEGIN" in pr[0].pattern][1]       # the second rule that reads BEGIN
+    rng = random.Random(321)
+    texts = ["".join(rng.choice(KEY_BLOCK_WORDS) for _ in range(rng.randint(1, 30))) for _ in range(5000)]
+    assert [t for t in texts if p.sub(r, t) != PIN_KEY_BLOCK.sub("<private-key-redacted>", t)] == []
+    assert sum(PIN_KEY_BLOCK.search(t) is not None for t in texts) > 3000          # the generator draws blocks (3,465)
+    b64 = base64.b64encode(token_bytes(48)).decode()
+    b64 = b64[:32] + "\n" + b64[32:]                   # lines under the opaque rule's 40, so only this rule acts on them
+    rule, heads = "-" * 5000, "----BEGIN RSA PRIVATE KEY----\n" * 50
+    two = ("----BEGIN A PRIVATE KEY----\n%s\n----END A PRIVATE KEY----\nKEEP zq\n----BEGIN B PRIVATE KEY----\n%s\n"
+           "----END B PRIVATE KEY----" % (b64, b64))
+    for text, want in (("----BEGIN RSA PRIVATE KEY-------END RSA PRIVATE KEY----", "<private-key-redacted>"),  # empty
+                       (rule + "\n---BEGIN EC PRIVATE KEY---\n%s\n---END EC PRIVATE KEY---\n" % b64 + rule,
+                        rule + "\n<private-key-redacted>\n" + rule),
+                       (heads + b64, heads + b64),                                  # no END: the text stays
+                       (two, "<private-key-redacted>\nKEEP zq\n<private-key-redacted>"),     # W15: a greedy body joins
+                       ("---\tBEGIN RSA PRIVATE KEY\t---\n%s\n---\tEND RSA PRIVATE KEY\t---" % b64,
+                        "<private-key-redacted>"),                                  # W13: a tab beside the dashes
+                       ("----BEGIN PGP PRIVATE KEY BLOCK----\n\n%s\n----END PGP PRIVATE KEY BLOCK----" % b64,
+                        "<private-key-redacted>")):                                 # W14: the BLOCK suffix
+        assert p.sub(r, text) == want == SCRUB(text), want[:30]
+
+
+# The Cookie rule as SCRUB2 wrote it (cdbc1b8:scripts/transcript_export.py:95). The generator's alphabet: heads in two
+# cases and Set-Cookie, colons, quotes, spaces, tabs, newlines, separators, names and values of 2 and 8 characters. It
+# draws no backslash, no `_` and no non-ASCII letter: there SCRUB2-R1 changes the rule on purpose (escapes, the left
+# anchor), and the tests above hold those contexts.
+PIN_COOKIE = re.compile(r"((?i:\b(?:set-)?cookie)[\"']?\s*:\s*[\"']?)(?=[^\r\n\"']*=[^\s;\"']{8})[^\r\n\"']+")
+COOKIE_WORDS = ("Cookie: ", "cookie:", "Set-Cookie:", "Cookie", ":", " ", "\t", "\n", "\r\n", '"', "'", "=", ";", "; ",
+                "sid=", "a=1", "AbCd1234", "Ab", "x", ",", "&", "sid=AbCd1234")
+
+
+def test_the_cookie_rule_hides_what_scrub2s_rule_hid_on_plain_text():
+    [(p, r)] = [pr for pr in MOD.SECRET_PATTERNS if "cookie" in pr[0].pattern]
+    rng = random.Random(3210)
+    texts = ["".join(rng.choice(COOKIE_WORDS) for _ in range(rng.randint(1, 40))) for _ in range(6000)]
+    assert [t for t in texts if p.sub(r, t) != PIN_COOKIE.sub(r"\1<redacted>", t)] == []
+    assert sum(PIN_COOKIE.search(t) is not None for t in texts) > 2000             # the generator draws matches (2,258)
+    # a later head holds a quote or a newline, so it reads a value past the first head's line end: the first head's
+    # no-value match stops before it (_COOKIE_X), and the value is hidden as before
+    v = _fake_value()
+    assert SCRUB('Cookie: x Cookie: "sid=%s"' % v) == 'Cookie: x Cookie: "%s"' % R
+    assert SCRUB("Cookie: x Cookie:\nsid=%s" % v) == "Cookie: x Cookie:\n" + R
