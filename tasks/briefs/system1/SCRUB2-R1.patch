+def test_each_named_rule_takes_8_characters_and_leaves_7():
+    # VERIFY-SCRUB2 F12 (W1-W5): the 8-character floor of the Cookie, scheme, pwd and credentials rules, both ways
+    v8, v7 = "7" + token_hex(4)[:6] + "q", "7" + token_hex(3)[:5] + "q"
+    for fmt, kept in (("Cookie: sid=%s; theme=x", "Cookie: "), ("Authorization: Token %s", "Authorization: Token "),
+                      ("pwd=%s", "pwd="), ("credentials=%s", "credentials=")):
+        assert SCRUB(fmt % v8) == kept + R, fmt
+        assert SCRUB(fmt % v7) == fmt % v7, fmt
