+# F5: inside canonical JSON a quote is `\"`; a value stops before its backslash, so the JSON stays valid and reads back as
+# the text with the value replaced.
+R1_QUOTED = (('echo "pwd=%s"', 'echo "pwd=' + R + '"'), ('echo "credentials=%s"', 'echo "credentials=' + R + '"'),
+             ('echo "Cookie: sid=%s"', 'echo "Cookie: ' + R + '"'),
+             ('curl -H "Cookie: a=1; sid=%s" https://zq.example', 'curl -H "Cookie: ' + R + '" https://zq.example'),
+             ('echo "Authorization: Token %s"', 'echo "Authorization: Token ' + R + '"'),
+             ("echo '{\"pwd\": \"%s\"}'", "echo '{\"pwd\": \"" + R + "\"}'"))
