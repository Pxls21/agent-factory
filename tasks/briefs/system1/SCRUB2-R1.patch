+# F15: in the raw view an escaped newline, carriage return, tab or form feed ends a value as the real one does, so a short
+# value stays under the floor and the next line stays whole. SCRUB2's forms redacted each of these into its next line.
+R1_ORDINARY = ("python3 - <<EOF\nclient = Client(credentials=None)\n\nrows = client.list()\nEOF",
+               "echo ok\nGOOGLE_APPLICATION_CREDENTIALS=0\nnext_step_here", "cd /tmp && pwd=ab1\r\nnext_line_words",
+               "Cookie: a=b\nnext=line_words_here", "f(credentials=cred)\tpadding_word_here",
+               "x = f(pwd=abc)\fnext_page_words")
+
+
+def test_r1_an_escaped_newline_or_tab_ends_a_value(tmp_path):
+    payload = getattr(MOD, "scrub_payload")
+    assert [t[:16] for t in R1_ORDINARY if payload(_canon({"command": t})) != _canon({"command": t})] == []
+    pin = _payload_with(PIN_R1)                                        # control: SCRUB2's forms change every one
+    assert [t[:16] for t in R1_ORDINARY if pin(_canon({"command": t})) == _canon({"command": t})] == []
+    assert [json.loads(c)["command"] for c in _through_convert(tmp_path, R1_ORDINARY)] == list(R1_ORDINARY)
+    # the value is still taken, the next line stays; a tab stays inside a Cookie header's line, as a real tab does
+    v = _fake_value()
+    for text, want in (("credentials=%s\nnext_line_here" % v, "credentials=%s\nnext_line_here" % R),
+                       ("Cookie: a=1;\tsid=%s\nnext_line_here" % v, "Cookie: %s\nnext_line_here" % R)):
+        assert payload(_canon({"command": text})) == _canon({"command": want})
