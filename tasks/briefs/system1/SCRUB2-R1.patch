+def test_every_authorization_scheme_hides_its_token(tmp_path):
+    rows = [("Authorization: %s %s" % (s, v), v) for s, v in ((s, _fake_value()) for s in SCHEMES)]
+    assert [(t.split()[1], fn.__name__) for t, v in rows for fn in (SCRUB, getattr(MOD, "scrub_payload"))
+            if not _no_piece(v, fn(t))] == []
+    v, w = _fake_value(), _fake_value()
+    # the word stays hidden, as the credential rule hid it before; the token stops before a Bearer match (AF-AP-157)
+    assert SCRUB("Authorization: Negotiate %s" % v) == "Authorization: %s %s" % (R, R)
+    out = SCRUB("Authorization: Negotiate %sBearer %s" % (v[:12], w))
+    assert _no_piece(v[:12], out) and _no_piece(w, out), out
+    assert _no_piece(v, getattr(MOD, "scrub_payload")(_canon({"command": 'curl -H "Authorization: Negotiate %s"' % v})))
+    blob = _through_digest(tmp_path, ["Authorization: Negotiate %s" % v])
+    [call] = _through_convert(tmp_path, ["curl -H 'Authorization: Negotiate %s' x" % w])
+    assert _no_piece(v, blob) and _no_piece(w, call)
