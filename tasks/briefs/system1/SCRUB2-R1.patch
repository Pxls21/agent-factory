+# F2 (the credential rule took the 9-letter word `Negotiate` as the value, and the token stayed) and F12's W7 (four schemes
+# no test held): every listed scheme's token is hidden by scrub and scrub_payload, and end to end.
+SCHEMES = ("Token", "Basic", "Bearer", "bearer", "Digest", "Negotiate", "NTLM", "ApiKey", "Api-Key", "Key", "SSWS")
