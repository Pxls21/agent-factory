+@pytest.mark.parametrize("fmt,want", R1_QUOTED)
+def test_r1_a_value_stops_before_an_escaped_quote(fmt, want):
+    v = _fake_value()
+    out = getattr(MOD, "scrub_payload")(_canon({"command": fmt % v}))
+    assert _no_piece(v, out) and json.loads(out) == {"command": want}, out
