+    opaque = [pr for pr in MOD.SECRET_PATTERNS if pr[1] == MOD.OPAQUE_MARK]
+    assert MOD.SECRET_PATTERNS == s1 + s2 + opaque and len(opaque) == 1 and len(s2) == len(R4_ORDER)
+    for rule, (fmt, canon) in zip(s2, R4_ORDER):
+        v = _v()
+        text = _canon({"command": fmt % v}) if canon else fmt % v
+        assert _hidden(v, _settle(text)) and _hidden(v, MOD.scrub_payload(text)), fmt[:24]
+        first = _settle_in([rule] + s1 + list(MOD.PAYLOAD_PATTERNS) + [pr for pr in s2 if pr is not rule] + opaque)
+        assert not _hidden(v, first(text)), fmt[:24]                   # control: that rule moved first shows the value
