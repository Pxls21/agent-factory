+# The order (SCRUB2-R1 round 4): every rule that reads a head the PIN never read (stage 2) runs after every rule that reads
+# a head the PIN reads (stage 1, and in scrub_payload the PAYLOAD rules). One text per stage-2 rule, in its order: that
+# rule, run first, takes the head of a rule that runs after it and the value that rule hid on the PIN shows (the control);
+# in the real order the value stays hidden. The decoded texts are convert()'s text events, the canonical ones its tool calls.
+R4_ORDER = (("Authorization: Negotiate YIIabcde.DB_PASS=\"%s\"", False),                          # the Negotiate token
+            ("my_cookie: sid=abcdefgh1; curl -u \"admin:%s\" https://zq.example", False),         # the Cookie rule
+            ("Authorization: " + BS + "\"Token abcdefghpassword=" + BS + "\"%s" + BS + "\"", False),  # the scheme rule
+            ("x" + BS + "tpwd=sid=abcdefgh1\nDB_PASSWORD=\"%s\"", True),                              # the pwd rule
+            ("y" + BS + "rcredentials = sid=abcdefgh1\r\ntoken=\"%s\"", True))                        # the credentials rule
+
+
+def _settle_in(order):
+    """_settle with the rules run in `order`."""
+    def run(text):
+        for _ in range(4):
+            out = text
+            for p, r in order:
+                out = p.sub(r, out)
+            if out == text:
+                return out
+            text = out
+        return "<UNSETTLED>"
+    return run
+
