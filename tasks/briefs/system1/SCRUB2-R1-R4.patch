+def test_the_lenient_key_block_rule_hides_what_scrub2s_rule_hid():
+    p, r = [pr for pr in MOD.SECRET_PATTERNS if "BEGIN" in pr[0].pattern][1]       # the second rule that reads BEGIN
+    rng = random.Random(321)
+    texts = ["".join(rng.choice(KEY_BLOCK_WORDS) for _ in range(rng.randint(1, 30))) for _ in range(5000)]
+    assert [t for t in texts if p.sub(r, t) != PIN_KEY_BLOCK.sub("<private-key-redacted>", t)] == []
+    assert sum(PIN_KEY_BLOCK.search(t) is not None for t in texts) > 3000          # the generator draws blocks (3,465)
+    b64 = base64.b64encode(token_bytes(48)).decode()
+    b64 = b64[:32] + "\n" + b64[32:]                   # lines under the opaque rule's 40, so only this rule acts on them
+    rule, heads = "-" * 5000, "----BEGIN RSA PRIVATE KEY----\n" * 50
+    two = ("----BEGIN A PRIVATE KEY----\n%s\n----END A PRIVATE KEY----\nKEEP zq\n----BEGIN B PRIVATE KEY----\n%s\n"
+           "----END B PRIVATE KEY----" % (b64, b64))
+    for text, want in (("----BEGIN RSA PRIVATE KEY-------END RSA PRIVATE KEY----", "<private-key-redacted>"),  # empty
+                       (rule + "\n---BEGIN EC PRIVATE KEY---\n%s\n---END EC PRIVATE KEY---\n" % b64 + rule,
+                        rule + "\n<private-key-redacted>\n" + rule),
+                       (heads + b64, heads + b64),                                  # no END: the text stays
+                       (two, "<private-key-redacted>\nKEEP zq\n<private-key-redacted>"),     # W15: a greedy body joins
+                       ("---\tBEGIN RSA PRIVATE KEY\t---\n%s\n---\tEND RSA PRIVATE KEY\t---" % b64,
+                        "<private-key-redacted>"),                                  # W13: a tab beside the dashes
+                       ("----BEGIN PGP PRIVATE KEY BLOCK----\n\n%s\n----END PGP PRIVATE KEY BLOCK----" % b64,
+                        "<private-key-redacted>")):                                 # W14: the BLOCK suffix
+        assert p.sub(r, text) == want == SCRUB(text), want[:30]
