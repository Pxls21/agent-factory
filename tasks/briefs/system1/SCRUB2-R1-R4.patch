+# AF-AP-152, VERIFY-SCRUB2 F7: the lenient key-block rule retried `-{3,}` at every dash of a run and scanned to the end of
+# the text from every BEGIN head with no END (over 20 s on 60,000 dashes; 0.014 s before SCRUB2), and the Cookie rule read
+# the rest of its line from every head (2.7 s on 64,000 characters). VERIFY-SCRUB2-R1 B1: round 1's value classes read a
+# backslash run again at every pair of it (29 s on 64,000 backslashes after a Cookie head); the texts from the Cookie head
+# on hold backslash runs, escapes and heads after each changed rule's head (the escaped Cookie heads killed a stop that
+# made each head read the rest of the line; the base64 token, the Negotiate token's stops). A child times each scrub on
+# each hostile text; every call must take under 2 s (the slowest took 0.28 s in the sandbox on 2026-09-28, under load),
+# and a stall fails the test at the child's timeout.
+LINEAR_CHILD = r"""
+import importlib.util, sys, time
+spec = importlib.util.spec_from_file_location("transcript_export_linear", sys.argv[1])
+te = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(te)
+head, B = "----BEGIN RSA PRIVATE KEY----\n", "\\"
+texts = [("60,000 dashes", "-" * 60000), ("60,000 dashes, then BEGIN", "-" * 60000 + "BEGIN RSA PRIVATE KEY----\nzq"),
+         ("4,000 BEGIN heads, no END", head * 4000), ("a BEGIN head, then 60,000 dashes", head + "-" * 60000),
+         ("12,000 cookie heads on a line", "cookie: x " * 12000), ("11,000 Set-Cookie heads", "Set-Cookie:" * 11000),
+         ("a Cookie head, then 60,000 backslashes", "Cookie: " + B * 60000),
+         ("a pwd head, then 60,000 backslashes", "pwd=a" + B * 60000),
+         ("a credentials head, then 60,000 backslashes", "credentials=a" + B * 60000),
+         ("a cookie value, then 60,000 backslashes and a quote", "Cookie: a=" + B * 60000 + '"'),
+         ("30,000 escaped newlines after a pwd head", "pwd=a" + (B + "n") * 30000),
+         ("14,000 escaped Cookie heads", ("Cookie:" + B + "n") * 14000),
+         ("7,000 CRLF Set-Cookie heads", ("Set-Cookie:" + B + "r" + B + "n  ") * 7000),
+         ("a Negotiate token of 60,000 base64 characters", "Authorization: Negotiate " + "Ab+/" * 15000),
+         ("12,000 my_cookie heads on a line", "my_cookie: " * 12000),
+         ("6,000 my_cookie and pwd heads, then a value", "my_cookie: a pwd: " * 6000 + "sid=abcdefghij")]
+for name, text in texts:
+    for fn in (te.scrub, te.scrub_payload):
+        t0 = time.perf_counter()
+        fn(text)
+        print("%s|%s|%.4f" % (name, fn.__name__, time.perf_counter() - t0), flush=True)
