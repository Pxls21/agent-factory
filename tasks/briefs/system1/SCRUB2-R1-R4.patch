+    assert [t for t in texts if p.sub(r, t) != PIN_COOKIE.sub(r"\1<redacted>", t)] == []
+    # stage 2's Cookie rule reads these heads again (SCRUB2-R1 round 4): what stage 1's left, it leaves as it is, and
+    # alone it hides what stage 1's hides (each stage's floor and value are pinned apart: in scrub one hides the other)
+    assert [t for t in texts if p2.sub(r2, p.sub(r, t)) != p.sub(r, t)] == []
+    assert [t for t in texts if p2.sub(r2, t) != p.sub(r, t)] == []
+    assert sum(PIN_COOKIE.search(t) is not None for t in texts) > 2000             # the generator draws matches (2,258)
+    # a later head holds a quote or a newline, so it reads a value past the first head's line end: the first head's
