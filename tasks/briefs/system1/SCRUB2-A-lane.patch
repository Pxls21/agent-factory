diff --git a/tasks/briefs/system1/scrubA/f1probe.py b/tasks/briefs/system1/scrubA/f1probe.py
new file mode 100644
index 0000000..97e0763
--- /dev/null
+++ b/tasks/briefs/system1/scrubA/f1probe.py
@@ -0,0 +1,35 @@
+"""F1's cells at the PIN: a fake per cell; LEAK when 8 characters of it survive. Prints labels only."""
+import importlib.util, json, secrets, sys
+spec = importlib.util.spec_from_file_location("te_probe", sys.argv[1])
+MOD = importlib.util.module_from_spec(spec); spec.loader.exec_module(MOD)
+B = "\\"
+def v(): return "7" + secrets.token_hex(8) + "q"
+def canon(o): return json.dumps(o, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+def hidden(val, out):
+    forms = {val, json.dumps(val)[1:-1]}
+    return not any(f[i:i+8] in out for f in forms for i in range(len(f)-7))
+def settle(t):
+    for _ in range(4):
+        o = MOD.scrub_payload(t)
+        if o == t: return o
+        t = o
+    return "<UNSETTLED>"
+heads = {"pwd": ("pwd=", "pwd"), "credentials": ("credentials=", "credentials"), "cookie": ("Cookie: sid=", "Cookie"),
+         "auth-token": ("Authorization: Token ", "Authorization")}
+rows = []
+for name, (plain, key) in heads.items():
+    cells = {}
+    x = v(); cells["line-start (canonical JSON)"] = ("payload", canon({"command": "echo a\n" + plain + x}), x)
+    x = v(); cells["after a tab (canonical JSON)"] = ("payload", canon({"command": "a\t" + plain + x}), x)
+    x = v()
+    doc = json.dumps({key: ("sid=" + x) if name == "cookie" else ("Token " + x) if name == "auth-token" else x})
+    cells["JSON document in a tool input"] = ("payload", canon({"command": "curl -d '" + doc + "'"}), x)
+    x = v(); cells["literal backslash-n, digest"] = ("scrub", '"user=zq' + B + 'n' + plain + x + '"', x)
+    x = v(); cells["literal backslash-n, payload"] = ("payload", '"user=zq' + B + 'n' + plain + x + '"', x)
+    x = v(); cells["after e-acute, digest"] = ("scrub", "café" + plain + x, x)
+    x = v(); cells["plain (control), digest"] = ("scrub", "a " + plain + x, x)
+    for label, (fn, text, val) in cells.items():
+        out = MOD.scrub(text) if fn == "scrub" else settle(text)
+        rows.append((name, label, "hid" if hidden(val, out) else "LEAK"))
+for r in rows: print("%-12s %-32s %s" % r)
+print("LEAK cells:", sum(1 for r in rows if r[2] == "LEAK"), "of", len(rows))
diff --git a/tasks/briefs/system1/scrubA/f7time.py b/tasks/briefs/system1/scrubA/f7time.py
new file mode 100644
index 0000000..ec3f5e5
--- /dev/null
+++ b/tasks/briefs/system1/scrubA/f7time.py
@@ -0,0 +1,13 @@
+"""F7 at the PIN: scrub() time on a dash run and on lenient BEGIN heads with no END, two sizes each (best of 3)."""
+import importlib.util, sys, time
+spec = importlib.util.spec_from_file_location("te_f7", sys.argv[1])
+MOD = importlib.util.module_from_spec(spec); spec.loader.exec_module(MOD)
+def best(text):
+    t = []
+    for _ in range(3):
+        a = time.perf_counter(); MOD.scrub(text); t.append(time.perf_counter() - a)
+    return min(t)
+for n in (5000, 10000):
+    print("dashes %6d: %.3f s" % (n, best("-" * n)))
+for n in (1000, 2000):
+    print("no-END heads %5d: %.3f s" % (n, best("--- BEGIN RSA PRIVATE KEY ---\n" * n)))
diff --git a/tasks/briefs/system1/vscrub2r4/vscrub2r1r4_red.py b/tasks/briefs/system1/vscrub2r4/vscrub2r1r4_red.py
new file mode 100644
index 0000000..d15d9e7
--- /dev/null
+++ b/tasks/briefs/system1/vscrub2r4/vscrub2r1r4_red.py
@@ -0,0 +1,82 @@
+"""VERIFY-SCRUB2-R1-R4's red tests (scratch only, never committed). R4V-1 (DISC-4, the cross-rule K-chain): a
+credentials value the credentials floor refuses (an escape among its first 8 characters: D1, or F15's shape in canonical
+JSON) is kept whole, so a head inside it, which the PIN never read (the PIN's credentials value hid its name), is read by
+a rule that runs after stage 1's credentials rule and before a later PIN-head rule: the Bearer tail, Basic, bearer, R1's
+escaped-quote credential, the PASS rule or the bridge link. That rule's token is glued to a later head (a PASS name, an
+escaped-quote credential, curl's `-u`, a URL, a lower-case bearer), takes that head's name, and the later value, which the
+PIN hid with its own rule, shows in convert()'s events. Every value is a fake built here. The PIN passes each item."""
+import importlib.util
+import json
+import pathlib
+import secrets
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+TOOL = ROOT / "scripts" / "transcript_export.py"
+_spec = importlib.util.spec_from_file_location("transcript_export_vscrub2r1r4", TOOL)
+MOD = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(MOD)
+B = "\\"
+
+
+def _v():
+    return "7" + secrets.token_hex(8) + "q"
+
+
+def _canon(obj):
+    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+
+
+def _hidden(v, out):
+    """no 8-character piece of v, as written or as JSON writes it, is in out"""
+    forms = {v, json.dumps(v)[1:-1]}
+    return not any(f[i:i + 8] in out for f in forms for i in range(len(f) - 7))
+
+
+def _settle(text):
+    """convert()'s scrub of one event's text: scrub_payload to a fixed point (at most 4 passes)"""
+    for _ in range(4):
+        out = MOD.scrub_payload(text)
+        if out == text:
+            return out
+        text = out
+    return "<UNSETTLED>"
+
+
+# canonical JSON (convert()'s tool_call): `credentials=<short>` then a real line end (F15's shape: the floor refuses it),
+# then a head on the next line whose token is glued to a later head
+@pytest.mark.parametrize("fmt", [
+    "export credentials=ab\nBearer k1a2b3c4d5e6f/DB_PASS=" + B + "\"%s" + B + "\"",
+    "[auth] credentials=q1\nAuthorization: " + B + "\"Basic dXNlcjpwYXNzQxtoken=" + B + "\"%s" + B + "\"",
+    "credentials=zz\nbearer k1a2b3c4d59~curl -u a:%s https://zq.example",
+    "credentials=U\nabcBearer k1qF5UwwJ7Lpcs/token=" + B + "\"%s" + B + "\" next",
+    "credentials=bT\r\nBearer khEPDGj0IKFUUP/https://u:%s@h.example",
+])
+def test_r4v1_a_head_inside_a_refused_value_in_canonical_json_frees_no_later_value(fmt):
+    v = _v()
+    assert _hidden(v, _settle(_canon({"command": fmt % v})))
+
+
+# decoded text (convert()'s text and tool_result events): a literal escape among the value's first 8 characters (D1)
+@pytest.mark.parametrize("fmt", [
+    "credentials=Z" + B + "tBearer k1a2b3c4d5e6f+X_PASS = %s",
+    "set credentials=y" + B + "rtoken=" + B + "\"k1a2b3c4d5;DB_PASS = %s",
+    "'credentials':'qcro7h" + B + "rabcBearer kFMIgtUHJ76U2+X_PASS = %s'",
+    "credentials=pfyXX" + B + "rx9y8z7w6Bearer kfl9ugaiT5LN2~curl -u \"a:%s\"",
+    "credentials=lP" + B + "tx9y8z7w6Authorization: " + B + "\"Basic kyCcooZO4/cN1/bearer %s" + B + "\"",
+])
+def test_r4v1_a_head_inside_a_refused_value_in_decoded_text_frees_no_later_value(fmt):
+    v = _v()
+    assert _hidden(v, _settle(fmt % v))
+
+
+# the control: the same texts with a value the floor takes (no escape among its first 8 characters) hide v on every version
+@pytest.mark.parametrize("fmt", [
+    "export credentials=abcdefgh\nBearer k1a2b3c4d5e6f/DB_PASS=" + B + "\"%s" + B + "\"",
+    "credentials=Zabcdefgh" + B + "tBearer k1a2b3c4d5e6f+X_PASS = %s",
+])
+def test_r4v1_control_a_value_the_floor_takes_hides_the_later_value(fmt):
+    v = _v()
+    text = fmt % v
+    assert _hidden(v, _settle(_canon({"command": text}) if "\n" in text else text))
