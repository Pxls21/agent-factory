+R1_CONTEXTS = (("a line start", "first line\n{s} rest"), ("after a tab", "a\t{s} rest"),
+               ("after a literal backslash-n", "zq" + BS + "n{s} rest"), ("after é", "café{s} rest"),
+               ("after の", "この{s} rest"), ("a JSON document", None), ("plain (control)", "x {s} rest"))
+
+
+def _r1_rows():
+    """(shape, context, text, fake): one fresh fake per cell."""
+    rows = []
+    for shape, fmt, doc in R1_SHAPES:
+        for ctx, cfmt in R1_CONTEXTS:
+            v = _fake_value()
+            rows.append((shape, ctx, json.dumps(_fill(doc, v)) if cfmt is None else cfmt.replace("{s}", fmt % v), v))
+    return rows
