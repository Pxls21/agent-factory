+
+def test_r1_named_rules_hold_every_f1_context_end_to_end(tmp_path):
+    rows = _r1_rows()
+    blob = _through_digest(tmp_path, [t for _, _, t, _ in rows])
+    calls = _through_convert(tmp_path, [t for _, _, t, _ in rows])
+    leaks = [(s, c, "digest") for s, c, _, v in rows if not _no_piece(v, blob)]
+    leaks += [(s, c, "convert") for (s, c, _, v), text in zip(rows, calls) if not _no_piece(v, text)]
+    assert leaks == []
