+def _settle(text):
+    """convert()'s scrub of one event's text: scrub_payload to a fixed point (at most 4 passes)"""
+    for _ in range(4):
+        out = MOD.scrub_payload(text)
+        if out == text:
+            return out
+        text = out
+    return "<UNSETTLED>"
