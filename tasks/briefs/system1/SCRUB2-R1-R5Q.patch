+
+def _payload_with(swaps):
+    """MOD's scrub_payload as SCRUB2 ran it: stage 1 with each rule whose pattern holds a key of `swaps` replaced by (that
+    pattern, `\\1<redacted>`), the PAYLOAD rules, then the opaque rule; no stage 2 (SCRUB2-R1 round 4), which SCRUB2 had not."""
+    pats, hit = [], []
+    for p, r in MOD.STAGE1_PATTERNS:
+        keys = [k for k in swaps if k in p.pattern]
+        hit += keys
+        pats.append((re.compile(swaps[keys[0]]), r"\1<redacted>") if keys else (p, r))
+    assert sorted(hit) == sorted(swaps), hit                           # each key names exactly one rule
+    order = pats + list(MOD.PAYLOAD_PATTERNS) + [pr for pr in MOD.SECRET_PATTERNS if pr[1] == MOD.OPAQUE_MARK]
+
+    def run(text):
+        for p, r in order:
+            text = p.sub(r, text)
+        return text
+    return run
+
+
+def _scrub_with_scrub2s_forms(text):
+    """MOD's scrub as SCRUB2 ran it (SCRUB2-R1 round 4): stage 1 with PIN_R1's forms in place of its four rules, then the
+    opaque rule; no stage 2."""
+    pats = []
+    for p, r in MOD.STAGE1_PATTERNS:
+        keys = [k for k in PIN_R1 if k in p.pattern]
+        pats.append((re.compile(PIN_R1[keys[0]]), r"\1<redacted>") if keys else (p, r))
+    for p, r in pats + [pr for pr in MOD.SECRET_PATTERNS if pr[1] == MOD.OPAQUE_MARK]:
+        text = p.sub(r, text)
+    return text
+
+
+def _r1_misses(payload):
+    """[(shape, context)] where a piece of the fake survives `payload` over the command's canonical JSON (convert's view)."""
+    return sorted({(s, c) for s, c, t, v in _r1_rows() if not _no_piece(v, payload(_canon({"command": t})))})
+
+
+def test_r1_contexts_red_on_scrub2s_forms_exactly_where_verify_scrub2_found_them():
+    assert _r1_misses(getattr(MOD, "scrub_payload")) == []
+    want = {(s, c) for s in ("pwd", "credentials", "cookie")
+            for c in ("a line start", "after a tab", "after a literal backslash-n", "a JSON document")}
+    want |= {("authorization", "a JSON document"), ("cookie", "after é"), ("cookie", "after の")}
+    assert _r1_misses(_payload_with(PIN_R1)) == sorted(want)
