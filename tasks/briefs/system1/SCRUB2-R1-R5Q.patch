+def test_r2_the_negotiate_token_is_base64_and_stops_before_other_heads():
+    # M22: a SPNEGO token is base64, with `+`, `/` and `=` padding (the fakes above are hex); its runs are under 40
+    # characters, so only this rule, not the opaque one, can hide it
+    v = "YII" + token_hex(6) + "+" + token_hex(6) + "/" + token_hex(6) + "Zq=="
+    for fn in (SCRUB, getattr(MOD, "scrub_payload")):
+        assert fn("Authorization: Negotiate %s" % v) == "Authorization: %s %s" % (R, R), fn.__name__
+    # M21: the floor is 8 characters, so a 10-character token is hidden
+    w = "YIIb" + token_hex(3)
+    assert SCRUB("Authorization: Negotiate %s" % w) == "Authorization: %s %s" % (R, R)
+    # `=` only pads the end: the token never takes a `name=value` pair that the Cookie rule's floor reads (before SCRUB2-R1
+    # the credential rule took the word `Negotiate` and the Cookie rule this whole line)
+    u = _fake_value()
