+# The four rules as SCRUB2 left them (cdbc1b8:scripts/transcript_export.py:95, 98-99, 103, 105-106), for the controls; each
+# key names the one rule of today's stage 1 it stands in for.
+PIN_R1 = {
+    "cookie)": r"((?i:\b(?:set-)?cookie)[\"']?\s*:\s*[\"']?)(?=[^\r\n\"']*=[^\s;\"']{8})[^\r\n\"']+",
+    "|ssws)": (r"((?i:authorization)[\"']?\s*:\s*[\"']?(?i:token|basic|bearer|digest|negotiate|ntlm|apikey|api-key|key"
+               r"|ssws)\s+)(?=[A-Za-z0-9._~+/=\-]{8})[A-Za-z0-9._~+/=\-]+"),
+    "(?i:pwd)": r"((?<![A-Za-z0-9])(?i:pwd)[\"']?\s*[:=]\s*[\"']?)(?![/~.$\\])(?=[^\s\"'&,;]{8})[^\s\"'&,;]+",
+    "(?i:credentials)": (r"((?<![A-Za-z0-9])(?i:credentials)(?:[\"']\s*:|\s*=)\s*[\"']?)(?![/~.$\\])(?=[^\s\"'&,;]{8})"
+                         r"[^\s\"'&,;]+"),
+}
