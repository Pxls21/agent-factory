+#!/usr/bin/env python3
+"""Tests for scripts/qwen_jev.py (D-079, task #241).
+
+Deterministic, LLM-free: the real pinned simple-jev oracle (imported from ~/simple-jev at its
+pinned revision), the real served tokenizer (~/qwen-jev-tokenizer), and a FAKE send that stands
+in for the OmniRoute NETWORK only. The key is a FAKE key file (QWEN_JEV_KEY_FILE); the real
+~/.config/qwen-jev/omniroute.key is never read here.
+
+  tests/test_qwen_jev.py
+
+Negative controls: each guard has a paired red case below (count mismatch, cloud model, missing
+fan_out, bounded label, non-pinned checkout, key leakage).
+"""
+import json
+import os
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+import scripts.qwen_jev as qwen_jev  # noqa: E402
+
+from scripts.qwen_jev import (  # noqa: E402
+    JevService,
+    TOKENIZER_DIR,
+    make_service,
+    read_key,
+    verify_pin,
+)
+
+SERVED = "qwen-local/qwen3.8-27b-local"
+
+# The real served tokenizer (tokenizers only; transformers in the venv is fine without torch).
+from transformers import AutoTokenizer  # noqa: E402
+
+TZ = AutoTokenizer.from_pretrained(TOKENIZER_DIR)
+
+# D-1 precondition: the oracle is used at its pinned revision.
+assert verify_pin()[0], "pinned simple-jev checkout does not match upstream.lock.yaml"
+qwen_jev.load_oracle()
+
+
+def make_service_for_tests(policy):
+    """A JevService with the real oracle and tokenizer, a FAKE send, and a FAKE key file."""
+    svc = JevService(TZ, policy, key="fake-key-not-real", send=None)
+    return svc
+
+
+def compile_branches(svc, state, questions):
+    """The oracle's own compile, as _single does it (one question type per request)."""
+    creq = qwen_jev._oracle["ClassifierRequest"].model_validate(
+        {"model": SERVED, "state": state, "questions": questions})
+    qwen_jev._oracle["prepare_policy"](creq, "v1", svc.policy)
+    compiled = svc.compiler.compile(creq)
+    qmap = {q.branch_id: q for q in compiled.plan.questions}
+    return compiled, qmap
+
+
+def fake_ok_response(svc, branch, sq, logprob_map=None):
+    """A wire response for one branch: the exact token count, the branch's answer labels present
+    in top_logprobs with fixed logprob values. logprob_map overrides values by token string."""
+    top = []
+    for i, label in enumerate(sq.output_labels):
+        tok = TZ.decode([branch.output_ids[i]])
+        lp = (logprob_map or {}).get(tok, -float(i + 1))
+        top.append({"token": tok, "logprob": lp})
+    # fill to 20 with deterministic non-label tokens, so the bounded case has a full top list
+    j = 1
+    while len(top) < 20:
+        top.append({"token": "fill%d" % j, "logprob": -(len(top) + 10.0)})
+        j += 1
+    top.sort(key=lambda t: t["logprob"])
+    return {
+        "model": SERVED,
+        "choices": [{"index": 0, "message": {"role": "assistant", "content": ""},
+                     "logprobs": {"content": top}}],
+        "usage": {"prompt_tokens": len(branch.token_ids), "completion_tokens": 1},
+    }
+
+
+def test_pin_passes_and_refuses_when_unpinned(tmp_path, monkeypatch):
+    """The pin check: the pinned checkout passes; a checkout at another revision is refused."""
+    ok, expected, actual, _reason = verify_pin()
+    assert ok and expected == actual
+    # negative control: a checkout at a different revision must be refused
+    other = tmp_path / "other-jev"
+    other.mkdir()
+    monkeypatch.setattr(qwen_jev, "SIMPLE_JEV", str(other))
+    ok2, _exp2, _act2, reason = verify_pin()
+    assert not ok2, "an unpinned checkout must be refused"
+    assert "not a checkout" in reason or "!=" in reason
+
+
+def test_pin_refuses_when_lock_missing(tmp_path, monkeypatch):
+    monkeypatch.setattr(qwen_jev, "UPSTREAM_LOCK", str(tmp_path / "missing.lock"))
+    ok, _exp, _act, reason = verify_pin()
+    assert not ok
+    assert "no advisory_jev_runtimes" in reason or "no " in reason
+
+
+def _ok_for(compiled, qmap, branch, sq, logprob_map=None):
+    """A valid wire response for one compiled branch (exact count, labels present, fixed logprobs)."""
+    return 200, fake_ok_response(None, branch, sq, logprob_map=logprob_map)
+
+
+def test_fake_key_never_in_body_logs_or_response(tmp_path, monkeypatch):
+    """D-6: a FAKE key file; the key may ride the Authorization header only."""
+    keyfile = tmp_path / "fake.key"
+    keyfile.write_text("FAKE-KEY-DO-NOT-LEAK\n")
+    os.chmod(keyfile, 0o600)
+    monkeypatch.setenv("QWEN_JEV_KEY_FILE", str(keyfile))
+    assert read_key(str(keyfile)) == "FAKE-KEY-DO-NOT-LEAK"
+
+    # the service must read the key from the FAKE file (not an inline key)
+    svc, _pin = make_service("examples_binary", key_file=str(keyfile), send=None)
+    state = {"finding": "the verifier reproduced the break through the real path"}
+    questions = {"q": {"type": "noul", "instructions": "Does it block?"}}
+    compiled, qmap = compile_branches(svc, state, questions)
+    br, sq = compiled.branches[0], qmap[compiled.branches[0].branch_id]
+    recorded = []
+
+    def send(messages, named):
+        # the transport test double: the real transport's Authorization header carries the key.
+        recorded.append({"auth": "Bearer " + svc._key, "body": messages})
+        return _ok_for(compiled, qmap, br, sq)
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    blob = json.dumps(out, sort_keys=True)
+    assert "FAKE-KEY-DO-NOT-LEAK" not in blob, "the key must never appear in a response"
+    # the key rides the Authorization header only
+    assert recorded and recorded[0]["auth"] == "Bearer FAKE-KEY-DO-NOT-LEAK"
+    for c in recorded:
+        assert "FAKE-KEY-DO-NOT-LEAK" not in json.dumps(c["body"], sort_keys=True), \
+            "the key must never appear in the wire body"
+
+
+def test_scoring_equals_oracle_on_fixed_logprobs():
+    """A branch whose label logprobs are fixed: the adapter's answer must equal what the oracle's
+    build_response gives for the same logits (the scoring boundary is the oracle's, not ours)."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"finding": "the verifier reproduced the break through the real path"}
+    questions = {"q": {"type": "choice", "instructions": "Which class?",
+                       "criteria": {"A": "breaks", "B": "follows up", "C": "notes only",
+                                    "D": "not reproduced", "E": "wrong contract", "F": "known"}}}
+    compiled, qmap = compile_branches(svc, state, questions)
+    sq = qmap[compiled.branches[0].branch_id]
+
+    def send(messages, named):
+        return 200, fake_ok_response(svc, compiled.branches[0], sq)
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    # oracle reference for the same fixed logits
+    logits = {compiled.branches[0].branch_id: {lab: float(-(i + 1))
+                                              for i, lab in enumerate(sq.output_labels)}}
+    ref = qwen_jev._oracle["build_response"](
+        compiled.plan, logits,
+        input_tokens=qwen_jev._oracle["unique_prompt_tokens"]([b.token_ids for b in compiled.branches]))
+    q = out["answers"]["q"]
+    assert q["choice"] == ref["answers"]["q"]["choice"]
+    assert not q.get("refused"), "a counted branch must not be refused: %r" % q.get("refused")
+
+
+def test_count_mismatch_refused():
+    """D-4: a branch whose prompt_tokens differ from the compiler's is refused, not scored."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"finding": "a short finding text"}
+    questions = {"q": {"type": "noul", "instructions": "Does it block?"}}
+    compiled, qmap = compile_branches(svc, state, questions)
+    sq = qmap[compiled.branches[0].branch_id]
+    resp = fake_ok_response(svc, compiled.branches[0], sq)
+    resp["usage"]["prompt_tokens"] = len(compiled.branches[0].token_ids) + 1  # the mismatch
+
+    def send(messages, named):
+        return 200, resp
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    q = out["answers"]["q"]
+    assert q["refused"], "a count-mismatch branch must be refused: %r" % q
+    assert q["noul"] is None, "a refused answer must not report a score"
+
+
+def test_cloud_served_model_refused():
+    """D-3: the response's model must name the local model; a cloud/combo id is a refusal."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"finding": "a short finding text"}
+    questions = {"q": {"type": "noul", "instructions": "Does it block?"}}
+    compiled, qmap = compile_branches(svc, state, questions)
+    sq = qmap[compiled.branches[0].branch_id]
+    resp = fake_ok_response(svc, compiled.branches[0], sq)
+    resp["model"] = "agentfactory-build-local"  # the build combo falls back to the cloud chain
+
+    def send(messages, named):
+        return 200, resp
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    q = out["answers"]["q"]
+    assert q["refused"], "a non-local served model must be refused: %r" % q
+    assert q["noul"] is None
+
+
+def test_bounded_label_named(tmp_path):
+    """D-4: a label absent from the top 20 is BOUNDED (the lowest shown logprob, an upper bound)
+    and named in the answer; it is never silently filled with a real value."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"finding": "a short finding text"}
+    questions = {"q": {"type": "noul", "instructions": "Does it block?"}}
+    compiled, qmap = compile_branches(svc, state, questions)
+    br = compiled.branches[0]
+    sq = qmap[br.branch_id]
+    labels = list(sq.output_labels)
+    # pick the label with the lowest fake logprob (index 0 = highest, last = lowest)
+    hi_tok = TZ.decode([br.output_ids[0]])
+    lo_tok = TZ.decode([br.output_ids[-1]])
+    resp = fake_ok_response(svc, br, sq, logprob_map={hi_tok: -0.1, lo_tok: -0.1})
+    # drop the low label's entry from the top list entirely (it is not in the top 20)
+    resp["choices"][0]["logprobs"]["content"] = [
+        t for t in resp["choices"][0]["logprobs"]["content"] if t["token"] != lo_tok]
+
+    def send(messages, named):
+        return 200, resp
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    q = out["answers"]["q"]
+    assert not q.get("refused"), "a counted branch with a bounded label must still be scored"
+    assert q.get("bounded_labels") == [labels[-1]], \
+        "the bounded label must be named: %r" % q.get("bounded_labels")
+    # the bounded label's logprob is the lowest shown (an upper bound): the answer must be finite
+    assert isinstance(q.get("noul"), float) and q["noul"] == q["noul"]
+
+
+def test_no_model_gets_served_id_and_fan_out(tmp_path):
+    """D-5: a request without `model` gets the served id; when every question id names a
+    state.chunks id, each question sees only its own chunk (the Laya fan-out) and the response
+    carries answers keyed by question id, usage, model, and fan_out."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"query": "what failed in the last run",
+             "chunks": [{"id": "r1", "text": "row one"}, {"id": "r2", "text": "row two"}]}
+    questions = {"r1": {"type": "noul", "instructions": "Does it show?"},
+                 "r2": {"type": "noul", "instructions": "Does it show?"}}
+
+    from scripts.qwen_jev import _chunk_map
+    chunk_map = _chunk_map(state)
+    per_call = {}
+    for qid in ("r1", "r2"):
+        one = JevService(TZ, "examples_binary", key="k", send=None)
+        c, qm = compile_branches(one, dict({"query": "what failed in the last run",
+                                            "chunk": chunk_map[qid]}, ), {qid: questions[qid]})
+        per_call[qid] = (c, qm)
+
+    calls = []
+
+    def send2(messages, named):
+        calls.append(messages)
+        # find which chunk this message carries -> which pre-compiled branch to answer
+        blob = json.dumps(messages)
+        qid = "r1" if '"chunk": "row one"' in blob else "r2"
+        c, qm = per_call[qid]
+        return 200, fake_ok_response(svc, c.branches[0], qm[c.branches[0].branch_id])
+
+    svc._send = send2
+    out = svc.systemone({"state": state, "questions": questions})  # no `model` field
+    assert out["model"] == SERVED, "a request without `model` must be answered as the served id"
+    assert out["fan_out"] == 2, "the per-chunk fan-out must be named: %r" % out.get("fan_out")
+    assert set(out["answers"]) == {"r1", "r2"}
+    assert "usage" in out and out["usage"].get("input_tokens", 0) >= 0
+    # each question saw only its own chunk
+    assert len(calls) == 2
+
+
+def test_single_call_fan_out_absent_when_not_a_chunk_batch(tmp_path):
+    """D-5 negative control: a batch with no state.chunks is one call, no fan_out."""
+    svc = make_service_for_tests("examples_binary")
+    state = {"finding": "a short finding text"}
+    compiled, qmap = compile_branches(svc, state, {"q": {"type": "noul",
+                                                         "instructions": "Does it block?"}})
+    sq = qmap[compiled.branches[0].branch_id]
+
+    def send(messages, named):
+        return 200, fake_ok_response(svc, compiled.branches[0], sq)
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state,
+                         "questions": {"q": {"type": "noul", "instructions": "Does it block?"}}})
+    assert "fan_out" not in out, "no fan_out for a non-chunk batch: %r" % out.get("fan_out")
+    assert out["model"] == SERVED
+
+
+def test_upstream_502_refused_not_scored():
+    """A transport/upstream 502 (e.g. the baseline noul whitespace-only token) is a refusal:
+    the answer is null and named, never a fake score."""
+    svc = make_service_for_tests("baseline")
+    state = {"finding": "a short finding text"}
+    questions = {"q": {"type": "noul", "instructions": "Does it block?"}}
+
+    def send(messages, named):
+        return 502, {"error": {"message": "upstream returned an empty response",
+                               "code": "upstream_empty_response"}}
+
+    svc._send = send
+    out = svc.systemone({"model": "laya", "state": state, "questions": questions})
+    q = out["answers"]["q"]
+    assert q.get("refused"), "an upstream 502 must be refused, not scored: %r" % q
+    assert q.get("noul") is None
+
+
+if __name__ == "__main__":
+    import pytest
+    sys.exit(pytest.main([__file__, "-v"]))
