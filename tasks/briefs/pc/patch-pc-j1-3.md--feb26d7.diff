+def _run(repo: Path, out: Path, *sources: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, str(SCRIPT), "--root", str(repo), "--out", str(out), *sources],
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
