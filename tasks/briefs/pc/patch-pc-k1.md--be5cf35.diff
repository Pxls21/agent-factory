+@pytest.mark.parametrize(
+    ("mutant_name", "mutate", "killer"),
+    [
+        (
+            "unsorted-tree-digest",
+            lambda text: text.replace(
+                'return sorted(records, key=lambda record: record[0].encode("utf-8"))',
+                "return records",
+            ),
+            "test_walk_is_sorted_before_digest",
+        ),
+        (
+            "empty-exclusions",
+            lambda text: text.replace(
+                'EXCLUDED_DIRS = frozenset({".git", "__pycache__", "node_modules"})',
+                "EXCLUDED_DIRS = frozenset()",
+            ).replace('EXCLUDED_SUFFIXES = (".pyc",)', "EXCLUDED_SUFFIXES = ()"),
+            "test_exclusions_do_not_affect_tree_record",
+        ),
+        (
+            "remove-sbom-agreement",
+            lambda text: text.replace("    validate_pin_agreement(root)\n", ""),
+            "test_sbom_pin_disagreement_is_named",
+        ),
+        (
+            "remove-symlink-refusal",
+            lambda text: text.replace(
+                "        raise ManifestError(\n"
+                "            f\"escaping symlink refused in {root.as_posix()}: {relative} -> {target}\"\n"
+                "        ) from error",
+                "        pass",
+            ),
+            "test_escaping_symlink_is_refused_by_root_and_link_name",
+        ),
+    ],
+)
+def test_required_mutants_are_killed(
+    tmp_path: Path,
+    mutant_name: str,
+    mutate,
+    killer: str,
+) -> None:
+    text = SCRIPT.read_text(encoding="utf-8")
+    mutated = mutate(text)
+    assert mutated != text, f"{mutant_name} mutation did not apply"
+    mutant_script = tmp_path / "scripts" / SCRIPT.name
+    mutant_script.parent.mkdir(parents=True)
+    mutant_script.write_text(mutated, encoding="utf-8")
+    test_copy = tmp_path / "test_vendored_manifest.py"
+    test_copy.write_text(Path(__file__).read_text(encoding="utf-8"), encoding="utf-8")
+    environment = os.environ.copy()
+    environment["PYTHONPATH"] = str(tmp_path)
+
+    result = subprocess.run(
+        [sys.executable, "-m", "pytest", "-q", str(test_copy), "-k", killer],
+        cwd=tmp_path,
+        env=environment,
+        check=False,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        timeout=240,
+    )
+
+    assert f"scripts/{SCRIPT.name}" in str(mutant_script.relative_to(tmp_path))
+    assert result.returncode == 1, f"{mutant_name} survived:\n{result.stdout}"
+    assert "1 failed" in result.stdout
