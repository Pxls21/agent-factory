+def test_generation_is_byte_identical_except_documented_timestamp(tmp_path: Path) -> None:
+    module = load_module()
+    root = copy_fixture(tmp_path, module)
+    first = module.render(root, generated_at="2026-09-08T00:00:00Z")
+    second = module.render(root, generated_at="2026-09-08T23:59:59Z")
+
+    assert first != second
+    assert module.normalize_generated_time(first) == module.normalize_generated_time(second)
+    differing_lines = [
+        left
+        for left, right in zip(first.splitlines(), second.splitlines(), strict=True)
+        if left != right
+    ]
+    assert differing_lines == ["Generated at (UTC): 2026-09-08T00:00:00Z"]
+
