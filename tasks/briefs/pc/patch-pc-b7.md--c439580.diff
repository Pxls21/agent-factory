name":"t3chat/qwen3-235b"},{"description":"Provider: OmniRoute Fedora","modelId":"custom:omniroute-fedora:t3-web/qwen3-235b","name":"t3-web/qwen3-235b"},{"description":"Provider: OmniRoute Fedora","modelId":"custom:omniroute-fedora:t3chat/qwen3-32b","name":"t3chat/qwen3-32b"},{"description":"Provider: OmniRoute Fedora","modelId":"custom:omniroute-fedora:t3-web/qwen3-32b","name":"t3-web/qwen3-32b"},{"description":"Provider: OmniRoute Fedora","modelId":"custom:omniroute-fedora:t3chat/kimi-k2","name":"t3chat/kimi-k2"},{"description":"Provider: OmniRoute Fedora","modelId":"custom:omniroute-fedora:t3-web/kimi-k2","name":"t3-web/kimi-k2"}],"currentModelId":"custom:s0-01-scripted/s0-01-pong"},"modes":{"availableModes":[{"description":"Ask before edits.","id":"default","name":"Default"},{"description":"Auto-allow workspace and /tmp edits; still asks for sensitive paths.","id":"accept_edits","name":"Accept Edits"},{"description":"Auto-allow file edits for this session except sensitive paths.","id":"dont_ask","name":"Don't Ask"}],"currentModeId":"default"},"sessionId":"ea80e4d3-e6df-4f76-89ae-88af72cca527"}},"seq":4,"t_utc":"2026-09-22T04:41:53.820026Z","t_mono_ns":60036122590150}
