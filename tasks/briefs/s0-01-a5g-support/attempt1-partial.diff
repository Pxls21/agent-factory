+# --- R2 / R8-CK-F6+F12: every startup value pinned, wrong-value bundle per key,
+# --- the parenthesised-key=value rejection, missing-keys exact reason, the
+# --- monkeypatch-proves-the-pin test -------------------------------------------------
+
+_STARTUP_PINS = [
+    ("mcp_cmd", "PINNED_STARTUP_MCP_CMD"),
+    ("permission_mode", "PINNED_STARTUP_PERMISSION_MODE"),
+    ("subscribe", "PINNED_STARTUP_SUBSCRIBE"),
+    ("context_limit", "PINNED_STARTUP_CONTEXT_LIMIT"),
+    ("max_turns_per_session", "PINNED_STARTUP_MAX_TURNS_PER_SESSION"),
+    ("heartbeat", "PINNED_STARTUP_HEARTBEAT"),
+    ("meh", "PINNED_STARTUP_MEH"),
+    ("memory", "PINNED_STARTUP_MEMORY"),
+    ("presence", "PINNED_STARTUP_PRESENCE"),
+    ("typing", "PINNED_STARTUP_TYPING"),
+    ("model", "PINNED_STARTUP_MODEL"),
+]
+
+
+def _mutate_startup(bundle, leg, key, new_val):
+    """Replace key=<old> with key=<new_val> in startup-line.txt AND buzzacp.log."""
+    sp = bundle / "golden" / leg / "startup-line.txt"
+    old = sp.read_text()
+    import re as _re
+    assert _re.search(rf"(^| ){_re.escape(key)}=", old), f"{key} not in startup line"
+    new = _re.sub(rf"(?<=\s){_re.escape(key)}=\S+", f"{key}={new_val}", old, count=1)
+    # parenthesised model token: model=(agent default) — handle separately
+    if key == "model":
+        new = old.replace("model=(agent default)", f"model={new_val}")
+    assert new != old, f"mutation of {key} did not apply"
+    _rewrite(sp, new)
+    lp = bundle / "golden" / leg / "buzzacp.log"
+    _rewrite(lp, lp.read_text().replace(old.rstrip("\n"), new.rstrip("\n")))
+
+
+@pytest.mark.parametrize("key,pin_name", _STARTUP_PINS)
+def test_ck8_startup_wrong_value_pinned_keys(bundle, key, pin_name):
+    """R8-CK-F6: one wrong-value hostile bundle per pinned startup key — the exact
+    failure names the key and both values."""
+    from pins import __dict__ as _pd
+    pinned = _pd[pin_name]
+    wrong = "(evil)" if str(pinned).startswith("(") else "9" if str(pinned).isdigit() \
+        else pinned + "X"
+    _mutate_startup(bundle, "run-1", key, wrong)
+    rc, out = _check(bundle)
+    assert rc == 1
+    assert out == f"failure_reason: run-1: startup {key} is {wrong!r}, expected {pinned!r}"
+
+
