+# --- R8-CK-F10: RUN the committed tee; assert the emitted key ORDER == the pin ---
+
+def test_ck8_f34_tee_emits_pinned_key_order(tmp_path):
+    """R8-CK-F10: execute the committed frame_tee.py as a subprocess (two frames on stdin,
+    then SIGTERM), read the tee-status.json it emits, and assert the emitted key TUPLE —
+    order included — equals pins.PINNED_TEE_STATUS_KEYS exactly. Kills any drift between
+    the tee's write order and the pin. The AST-based test_ck7_f34_frame_tee_keys_match_pin
+    stays as the second, static instrument (set equality, no run)."""
+    import subprocess, time, os, signal as _sig
+    from pins import PINNED_TEE_STATUS_KEYS as _PIN
+    agent_code = (
+        "import sys, json\n"
+        "for line in sys.stdin:\n"
+        "    obj = json.loads(line)\n"
+        "    resp = {'jsonrpc': '2.0', 'id': obj.get('id'), 'result': {}}\n"
+        "    sys.stdout.write(json.dumps(resp) + '\\n')\n"
+        "    sys.stdout.flush()\n"
+    )
+    framedir = tmp_path / "frames"
+    framedir.mkdir()
+    agent = tmp_path / "agent.py"
+    agent.write_text(agent_code)
+    env = os.environ.copy()
+    env["S0_01_FRAMEDIR"] = str(framedir)
+    env["S0_01_AGENT"] = sys.executable
+    env["S0_01_AGENT_ARGS"] = str(agent)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    frames = [json.dumps({"jsonrpc": "2.0", "id": i, "method": "session/x", "params": {}})
+              for i in (1, 2)]
+    proc = subprocess.Popen([sys.executable, str(P / "tools" / "frame_tee.py"),
+                             env["S0_01_AGENT_ARGS"]],
+                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, env=env)
+    try:
+        for f in frames:
+            proc.stdin.write((f + "\n").encode())
+            proc.stdin.flush()
+            time.sleep(0.1)
+        # poll for the running status to appear, then SIGTERM
+        status_path = framedir / "tee-status.json"
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline and not status_path.exists():
+            time.sleep(0.05)
+        proc.send_signal(_sig.SIGTERM)
+        proc.wait(timeout=10)
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait(timeout=5)
+    status_path = framedir / "tee-status.json"
+    assert status_path.exists(), "tee emitted no tee-status.json"
+    emitted = json.loads(status_path.read_text())
+    assert tuple(emitted.keys()) == tuple(_PIN), (
+        f"emitted key order {tuple(emitted.keys())} != PINNED_TEE_STATUS_KEYS {tuple(_PIN)}")
+
