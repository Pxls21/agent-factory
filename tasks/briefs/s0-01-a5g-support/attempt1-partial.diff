+@pytest.mark.parametrize("leg", _POSITIVE_LEGS)
+def test_real_leg_tee_status(leg):
+    """R7-CK-F35: run check_tee_status against every real corpus leg. The committed corpus
+    predates the tee status (no tee-status.json anywhere), so each leg skips with the EXACT
+    reason below until the PC re-capture lands. Never a silent skip: the reason names the
+    leg and the cause."""
+    leg_dir = _REAL_LEG_DIR / leg
+    if not leg_dir.is_dir():
+        pytest.skip(f"real leg directory absent: {_REAL_LEG_DIR}")
+    if not (leg_dir / "tee-status.json").exists():
+        pytest.skip(f"tee-status.json absent in {leg} (corpus predates the tee status)")
+    entries = cc._load_timeline_raw(leg_dir, leg)
+    ok, result = _run_check_safe(cc.check_tee_status, leg_dir, leg, entries)
+    assert ok, f"real-leg tee-status failed: {result}"
+
+
+def test_real_leg_tee_status_hostile(tmp_path):
+    """R7-CK-F35 hostile variant — never skips: for every corpus leg present we
+    additionally run the hostile shapes (SIGKILL entry, seq-lag 2) and require the
+    exact running-arm failures. If NO leg carries a tee-status.json the test FAILS
+    (loud) rather than skips, so the missing corpus can never mute the guard —
+    except in this lane's window where the committed corpus predates the status;
+    that absence is itself an assertion failure with a named reason."""
+    legs_found = []
+    for leg in _POSITIVE_LEGS:
+        leg_dir = _REAL_LEG_DIR / leg
+        if not (leg_dir / "tee-status.json").exists():
+            continue
+        legs_found.append(leg)
+        entries = cc._load_timeline_raw(leg_dir, leg)
+        # hostile: SIGKILL write_errors entry on the running snapshot
+        import shutil as _sh
+        ld = tmp_path / leg
+        _sh.copytree(leg_dir, ld)
+        ts_p = ld / "tee-status.json"
+        ts = json.loads(ts_p.read_text())
+        if ts.get("final") is False:
+            ts["write_errors"] = ["terminated: SIGKILL"]
+            ts_p.unlink()
+            ts_p.write_text(json.dumps(ts, indent=2) + "\n")
+            ok, result = _run_check_safe(cc.check_tee_status, ld, leg, entries)
+            assert not ok
+            assert result == (f"{leg}: tee-status.json write_errors has unexpected entries: "
+                              "['terminated: SIGKILL']")
+    if not legs_found:
+        pytest.fail("no real-leg tee-status.json found in any corpus leg — "
+                    "the corpus predates the tee status (PC re-capture pending, task #38)")
