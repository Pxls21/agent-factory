+def test_ck8_startup_missing_keys_exact_reason(bundle):
+    """R8-CK-F6: the required set is the full 21 keys — a line carrying only the old 11
+    required keys fails, listing exactly the missing 10."""
+    sp = bundle / "golden" / "run-1" / "startup-line.txt"
+    old = sp.read_text().rstrip("\n")
+    keep = {"relay", "pubkey", "agent_cmd", "mcp_cmd", "idle_timeout", "max_turn",
+            "agents", "dedup", "session_policy", "ignore_self", "permission_mode",
+            "respond_to"}
+    prefix, _, rest = old.partition("buzz-acp starting: ")
+    tokens = rest.split(" ")
+    kept = []
+    i = 0
+    while i < len(tokens):
+        t = tokens[i]
+        k = t.split("=", 1)[0] if "=" in t else ""
+        if k == "model" and "(" in t and ")" not in t:
+            # swallow the parenthesised model token's parts
+            while ")" not in tokens[i]:
+                i += 1
+            i += 1
+            continue
+        if k in keep:
+            kept.append(t)
+        i += 1
+    new = prefix + "buzz-acp starting: " + " ".join(kept) + "\n"
+    _rewrite(sp, new)
+    lp = bundle / "golden" / "run-1" / "buzzacp.log"
+    old_log = lp.read_text()
+    _rewrite(lp, old_log.replace(old, new.rstrip("\n")))
+    rc, out = _check(bundle)
+    assert rc == 1
+    assert out == ("failure_reason: run-1: startup-line missing keys: "
+                   "['context_limit', 'heartbeat', 'max_turns_per_session', 'meh', 'memory', "
+                   "'model', 'presence', 'subscribe', 'typing']")
+
