# Qwen3.8-27B vLLM local model server: the FALLBACK of the live SGLang unit (deploy/qwen.container; task #454's switch,
# D-129). The keeper from 2026-09-16 (D-032) to the switch; its image stays pinned in upstream.lock.yaml.
# Provenance: agent-factory docs/research/findings/VLLM-MIGRATION.md + upstream.lock.yaml (digest pin).
# Serves qwen3.8-27b-local (what OmniRoute's agentfactory-*-local combos forward) and the bare qwen3.8-27b too.
#
# Deployed beside the start script at ~/.config/qwen-serving/qwen-vllm.container: outside Quadlet's directory, so it
# never starts by itself. It runs as the qwen unit, in place of the SGLang file, on the same name and port:
#   cp ~/.config/qwen-serving/qwen-vllm.container ~/.config/containers/systemd/qwen.container ;
#   systemctl --user daemon-reload ; systemctl --user restart qwen
# Back to SGLang: copy deploy/qwen.container there again, daemon-reload, restart.
# It requires the syv-ai rootless CDI spec (~/cdi/nvidia.yaml + containers.conf cdi_spec_dirs),
# the prepared model tree at ~/qwen-serving/models, and the api-key file at
# ~/.config/qwen-builder/api-key (mounted read-only to /app/api_key.txt; the entrypoint reads it).
# Second fallback = the llama.cpp qwen-builder unit (D-027), which serves the SAME name on the SAME port:
#   systemctl --user stop qwen ; podman rm -f qwen ; systemctl --user reset-failed qwen-builder ; systemctl --user start qwen-builder
[Unit]
Description=Qwen3.8-27B vLLM local model server (behind OmniRoute; D-032)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=qwen
Image=ghcr.io/syv-ai/qwen38-27b-rtx3090@sha256:c52d9033527df5249d2f7306b35173a47f4f87d45bb60927fbe93fdb4986aacb
Exec=batch
PublishPort=8080:8080
Volume=qwen-cache:/cache
Volume=/home/rocco/qwen-serving/models:/app/models
Volume=/home/rocco/.config/qwen-builder/api-key:/app/api_key.txt:ro
Environment=PORT=8080
Environment=SPEC=mtp
Environment=MAX_LEN=131072
Environment=PREFIX_CACHE=1
# GPU_UTIL (owner ruling D-099, 2026-09-26: "Reduce the kv cache a little so they both fit"): the image's
# batch/start_qwen.sh default is 0.972. laya-systemone (the System-1 server, on the CPU) keeps a 256 MiB CUDA
# context from its device probe; at 0.972 that left vLLM 63 MiB of slack, a four-request load hit a CUDA OOM
# in the DeltaNet prefill workspace (07:52Z), and every restart then failed the startup free-memory check
# (22.8 GiB free, 22.9 GiB wanted). 0.96 gives back the slack vLLM had before laya (about 0.7 GiB) for a
# KV pool about 0.28 GiB smaller.
Environment=GPU_UTIL=0.96
Environment="EXTRA_ARGS=--served-model-name qwen3.8-27b-local qwen3.8-27b"
PodmanArgs=--ipc=host --device nvidia.com/gpu=all

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
