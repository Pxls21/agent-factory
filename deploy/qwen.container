# Qwen3.8-27B SGLang local model server, behind OmniRoute (the switch of task #454; D-129; pinned in pc-lane.lock.yaml, D-131).
# Provenance: tasks/briefs/serving/SGLANG-EVIDENCE-report.md (sections J and K, the two GPU windows that chose these
# flags) and pc-lane.lock.yaml (the image digest, the SGLang commit, the model revision, the start script's hash).
#
# This is the deployed copy of the PC-side rootless Quadlet at
#   ~/.config/containers/systemd/qwen.container  (systemctl --user, linger on).
# Deploy: copy deploy/sglang_start.py to ~/.config/qwen-serving/sglang_start.py and this file to that path,
# `systemctl --user daemon-reload`, `systemctl --user restart qwen` (only with no local-route lane live).
# The key: deploy/sglang_start.py reads the key file (mounted read-only to /app/api_key.txt) and starts SGLang with
# --config, so the key is on no command line, and it replaces the key in every line the server logs (SGLang logs its
# arguments, the key among them, at startup). MAX_LEN is the one statement of the context: the start script passes it
# to SGLang, and harness-ports/bin/lane-profile.sh reads it for every lane profile.
# It serves qwen3.8-27b-local, the name OmniRoute's qwen-local node and the agentfactory-*-local combos forward; SGLang
# does not check a request's model name, so the bare qwen3.8-27b still answers. /health, /ready and /metrics need no key.
# Fallback = the vLLM unit (deploy/qwen-vllm.container, D-032; deployed beside the start script), same name, same port:
#   cp ~/.config/qwen-serving/qwen-vllm.container ~/.config/containers/systemd/qwen.container ;
#   systemctl --user daemon-reload ; systemctl --user restart qwen
# --disable-prefill-cuda-graph keeps GPU headroom (2026-10-02, task #454): the grammar kernels behind constrained
# output (forced tool calls, JSON schemas) load on first use, after startup, and took about 0.6 GB. With the prefill
# CUDA graphs (2.27 GB) SGLang had 1.17 GB left and ran out of memory on the first Hermes lane's long prompt
# (03:53:58Z); without them it starts with about 3.4 GB left (report section K).
# --sleep-on-idle keeps an idle server off the CPU (2026-10-02, D-135): without it the scheduler loops without waiting
# and pins one CPU thread at 100% for as long as the server runs, in SGLang's own words (the IdleSleeper's docstring,
# managers/scheduler_components/idle_sleeper.py; the flag is off by default in this build, arg_groups/fields/device.py).
# With it, an idle scheduler waits on its sockets until a request arrives. A running request still keeps it busy.
[Unit]
Description=Qwen3.8-27B SGLang local model server (behind OmniRoute; D-129)
Wants=network-online.target
After=network-online.target
# The CPU heat guard (deploy/heat-guard.service, D-136): this unit starts after it and stops when it is stopped.
Requires=heat-guard.service
After=heat-guard.service

[Container]
ContainerName=qwen
Image=ghcr.io/0xsero/sglang-exl3@sha256:84f75f3424c99a3d63392a4e0348292bdeba9cf7efba2ff1aa9b85c8fc0131e8
Entrypoint=/opt/entrypoint.sh
Exec=python3 /af/sglang_start.py \
  --model-path /models/turboderp-Qwen3.8-27B-exl3-3.00bpw --quantization exl3 --trust-remote-code \
  --host 0.0.0.0 --port 8080 --served-model-name qwen3.8-27b-local \
  --kv-cache-dtype fp8_e4m3 --mamba-ssm-dtype bfloat16 --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
  --speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 \
  --speculative-token-map /opt/sglang-exl3/tokenmaps/qwen38_hot32k_v2.pt \
  --enable-metrics --enable-cache-report \
  --mem-fraction-static 0.80 --max-running-requests 4 --max-mamba-cache-size 12 --cuda-graph-max-bs-decode 4 \
  --chunked-prefill-size 4096 --max-prefill-tokens 4096 --prefill-decode-interval 16 --disable-prefill-cuda-graph \
  --mamba-radix-cache-strategy no_buffer --disable-overlap-schedule --sleep-on-idle \
  --enable-hierarchical-cache --hicache-size 24 --hicache-write-policy write_through --schedule-policy lpm
PublishPort=8080:8080
Volume=/home/rocco/models/qwen3.8-27b-exl3-3.0bpw:/models/turboderp-Qwen3.8-27B-exl3-3.00bpw:ro
Volume=/home/rocco/.config/qwen-builder/api-key:/app/api_key.txt:ro
Volume=/home/rocco/.config/qwen-serving/sglang_start.py:/af/sglang_start.py:ro
Environment=MAX_LEN=131072
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=HF_HUB_OFFLINE=1
Environment=SGLANG_EXL3_EMBED_HOST=1
Environment=SGLANG_EXL3_KERNEL=auto
Environment=SGLANG_EXL3_MODEL_PATH=/models/turboderp-Qwen3.8-27B-exl3-3.00bpw
Environment=SGLANG_OPT_MAMBA_SKIP_DECODE_LOCK=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PodmanArgs=--ipc=host --device nvidia.com/gpu=all

[Service]
Restart=always
RestartSec=10
# At most three of the PC's twelve CPU threads, spread over any cores (D-136): the PC went down four times on 2026-10-02
# while SGLang loaded beside an old cooler (AF-AP-263); its measured start used about 1.2 threads on average.
CPUQuota=300%

[Install]
WantedBy=default.target
